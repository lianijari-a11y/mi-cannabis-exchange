# Copy to .env and fill in real values. Never commit .env (already gitignored).

# SQLite by default for zero-setup local dev. Swap to a hosted Postgres
# connection string (Supabase, Neon) before production, same as LaneMatch.
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API key for the "structure my upload with AI" assistant on the
# grower/processor/broker listing form (lib/ai-listing.ts). Without it, that
# button shows a "not configured" message and sellers just fill the form by
# hand — see console.anthropic.com for a key.
ANTHROPIC_API_KEY=""

# Vercel Blob Storage — where uploaded listing photos/videos, invoices, and
# proof-of-delivery documents actually live (lib/media.ts). Auto-provisioned
# by `vercel blob create-store` and synced to every Vercel environment; for
# local dev, `vercel env pull` (or copy it from the Vercel dashboard) into
# your own .env.
BLOB_READ_WRITE_TOKEN=""

# Resend — powers the self-service "forgot password" email (lib/email.ts).
# Without it, /forgot-password shows an honest "not configured yet, ask an
# Admin/AE to reset it for you" message instead of silently failing to
# send. Sign up at resend.com for a key; RESEND_FROM_ADDRESS defaults to
# Resend's own sandbox sender if unset (fine for testing, not for real
# users — verify a real sending domain before launch).
RESEND_API_KEY=""
RESEND_FROM_ADDRESS=""

# Google Maps Platform — powers real address geocoding at signup
# (lib/geocoding.ts, server-side only). Without it, addresses stay free
# text exactly as before (an honest no-op, not an error). Needs a Google
# Cloud project with billing enabled and the Geocoding API turned on —
# console.cloud.google.com.
GOOGLE_MAPS_API_KEY=""

# Same Google Maps Platform project, but the client-exposed key (NEXT_
# PUBLIC_ so it's inlined into the browser bundle) that renders the live
# shipment-tracking map (components/deal/shipment-timeline.tsx) via the
# Static Maps API. Google Maps keys are designed to be exposed client-side
# — restrict this one by HTTP referrer in the Cloud console, not by
# keeping it secret. Needs the Maps Static API turned on. Without it, live
# tracking still works, just shows raw coordinates instead of a map image.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Vonage Messages API — texting leads from the Marketing Suite
# (lib/vonage-sms.ts). Without all three set, the "Text" button on a lead
# just doesn't appear. VONAGE_FROM_NUMBER is the Vonage number/sender ID
# messages are sent from. Once deployed, also set this deployment's
# https://<domain>/api/vonage/inbound-sms as the application's "Inbound
# URL" in the Vonage dashboard — that's what lets a lead's "wrong number"
# or "stop" reply actually reach lib/vonage-inbound.ts and suppress
# future texts to them.
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_FROM_NUMBER=""

# Authorizes Vercel Cron's own calls to /api/cron/send-scheduled-messages
# (lib/lead-messaging.ts's processDueCampaigns — the mechanism that
# actually fires a lead-message campaign scheduled for a future time, or
# finishes a large "send now" one). Vercel automatically attaches
# `Authorization: Bearer <this value>` to its own cron requests once this
# is set on the deployment; generate with `openssl rand -hex 32`. Not
# needed for local dev (cron never fires there) — this route just skips
# the check entirely when the env var is unset.
CRON_SECRET=""
