// MI Cannabis Exchange — Prisma schema
// Postgres (Supabase) — see CLAUDE.md §7. Started on SQLite for zero-setup
// local dev; moved to hosted Postgres once a project was provisioned.
// role/category/status fields stayed plain Strings (not native Postgres
// enums) rather than churn every model now that a real enum type is
// available — valid values are enforced in application code, see
// src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Core identity ----------
// role: "grower" | "processor" | "retailer" | "broker" | "transporter" | "admin"
model User {
  id           String   @id @default(cuid())
  role         String
  email        String   @unique
  passwordHash String
  fullName     String
  businessName String?

  // Pickup/delivery address — grower/processor/retailer fill this in at
  // signup so a Shipment has somewhere to route to. Not collected for
  // broker/transporter/admin.
  address String?
  city    String?
  state   String?
  zip     String?

  // License fields — grower/processor/retailer/transporter only (MI's Secure
  // Transporter license, same licensing tier as the others). Verified by
  // Admin, never auto-verified (no MI equivalent of FMCSA SAFER exists yet,
  // see CLAUDE.md §8).
  licenseNumber       String?
  licenseType         String?
  licenseVerification String  @default("unverified") // unverified | approved | rejected
  licenseExpiry       DateTime? // shown in Admin's license expiration alerts
  phone               String?

  // True when licenseVerification was set to "approved" automatically by
  // matching licenseNumber against LicenseRegistry at signup, rather than by
  // an Admin manually reviewing it. Admin UI shows this distinctly so a real
  // person can still audit/revoke a match — see CLAUDE.md §12.
  licenseAutoMatched Boolean @default(false)

  // Platform owner's default transporter, pre-selected (but overridable) when
  // a retailer picks who ships their deal. Admin-only toggle. Only meaningful
  // for role = transporter.
  preferredTransporter Boolean @default(false)

  // Admin-set standing commission rate for a Sales Rep, applied automatically
  // to every deal closed from a listing they created — see
  // SalesRepCommission below and CLAUDE.md §18. Only meaningful for
  // role = sales_rep. Null/0 means no commission is computed.
  salesRepCommissionRate Float?

  // Stable anonymous handle shown to the counterparty across the blind
  // marketplace boundary, e.g. "Grower #A17". Generated once at signup,
  // never derived from the real name so it can't leak identity. Transporters
  // get one too for consistency, but their real business name is always
  // shown — transport identity isn't part of the grower/retailer blind
  // boundary, see CLAUDE.md §3/§10.
  anonHandle String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings           Listing[]       @relation("ListingPostedBy")
  listingsCreatedAsSalesRep Listing[] @relation("ListingCreatedBySalesRep")
  offerRoundsMade    OfferRound[]    @relation("OfferRoundActor")
  retailerThreads    OfferThread[]   @relation("ThreadRetailer")
  dealsAsSeller      Deal[]          @relation("DealSeller")
  dealsAsRetailer    Deal[]          @relation("DealRetailer")
  shipmentsHauled    Shipment[]      @relation("ShipmentTransporter")
  watchlistEntries   Watchlist[]
  listingDismissals  ListingDismissal[]
  splitContractsAsGrower    SplitContract[] @relation("SplitContractGrower")
  splitContractsAsProcessor SplitContract[] @relation("SplitContractProcessor")
  notifications      Notification[]
  commissionsSet      Commission[]
  monthlyReportsUploaded MonthlyMarketReport[]
  posConnection          PosConnection?
  agreementAcceptances   AgreementAcceptance[]
  productRequests            ProductRequest[]         @relation("ProductRequestRetailer")
  productRequestResponsesSent ProductRequestResponse[] @relation("ProductRequestResponseSupplier")
  salesRepCommissionsEarned  SalesRepCommission[]
  metrcConnection            MetrcConnection?

  @@map("users")
}

// Records that a user clicked "I agree" on a given agreement, at a given
// version, at a given time — currently used for the platform-wide
// non-circumvention agreement (see CLAUDE.md §18). One row per
// (user, agreementType): accepting again after a version bump overwrites
// the prior row rather than keeping history, since all that ever matters
// for gating access is "did they accept the *current* version." The
// underlying legal text is a placeholder pending review by an actual MI
// cannabis attorney (same posture as CLAUDE.md §9's legal-template-content
// caveat) — this model only tracks the click, it isn't itself the contract.
model AgreementAcceptance {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreementType String // "non_circumvent"
  version       String
  acceptedAt    DateTime @default(now())

  @@unique([userId, agreementType])
  @@map("agreement_acceptances")
}

// In-app only — no SMS/push, see CLAUDE.md §8. type is a free-form tag
// ("offer_viewed", "offer_countered", ...) used for icon/routing choices in
// the UI, not enforced at the DB layer.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  threadId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ---------- Listings ----------
// category: "flower" | "concentrate" | "vape" | "edible" | "pre_roll" | "other"
// unit: "lb" | "liter" | "unit"
// terms: "cash" | "net_30" | "negotiable"
// status: "active" | "expired" | "closed" (closed = a Deal was made)
model Listing {
  id          String   @id @default(cuid())
  postedById  String
  postedBy    User     @relation("ListingPostedBy", fields: [postedById], references: [id])

  // Set when a Sales Rep built this listing on behalf of postedById (see
  // lib/sales-actions.ts) instead of the seller posting it themselves —
  // postedById is still the real Grower/Processor, so anonymization and
  // ownership work exactly the same either way; this is purely an audit
  // trail of who actually did the data entry. Never shown to buyers.
  createdBySalesRepId String?
  createdBySalesRep   User?   @relation("ListingCreatedBySalesRep", fields: [createdBySalesRepId], references: [id])

  strainName  String
  category    String
  thcPercent  Float?
  quantity    Float
  unit        String
  pricePerUnit Float
  terms       String
  notes       String?

  status    String   @default("active")
  expiresAt DateTime?

  // Distribution control — added 2026-08-16, a deliberate, confirmed
  // reversal of the original "every listing visible to every retailer,
  // nothing platform-gated" rule (CLAUDE.md decision #3). Same posture as
  // §11's commission reversal: not a silent decision, flagged and
  // explicitly confirmed. "all" (default) preserves the original bulletin-
  // board behavior; "exclusive" restricts visibility to exclusiveRetailerIds,
  // set by Admin. See CLAUDE.md §18.
  visibility           String   @default("all") // "all" | "exclusive"
  exclusiveRetailerIds String[] @default([])

  // Bumped by the seller's one-click "still available" confirmation
  // (lib/listings.ts's confirmListingFresh) or by any edit to the listing.
  // Feed sort offers a "recently confirmed" option and the seller dashboard
  // flags anything stale — see CLAUDE.md §13. Never used to gate or hide a
  // listing from the feed, only to inform.
  lastConfirmedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media   ListingMedia[]
  threads OfferThread[]
  watchlistedBy  Watchlist[]
  dismissedBy    ListingDismissal[]
  splitContracts SplitContract[]
  productRequestResponses ProductRequestResponse[]

  @@index([status])
  @@map("listings")
}

// A retailer tracking a listing they haven't (yet) made an offer on.
model Watchlist {
  id         String   @id @default(cuid())
  retailerId String
  retailer   User     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([retailerId, listingId])
  @@map("watchlist_entries")
}

// A retailer marking a listing "Not interested" — same shape as Watchlist,
// opposite intent: hides it from that retailer's own feed only (never
// affects what anyone else sees, and never affects the listing itself).
// Reversible from the retailer's dismissed-listings view.
model ListingDismissal {
  id         String   @id @default(cuid())
  retailerId String
  retailer   User     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([retailerId, listingId])
  @@map("listing_dismissals")
}

// "Wanted board" — a retailer posts a product they need that isn't
// currently listed; visible to Growers/Processors/Brokers the same way a
// Listing is visible to Retailers, just mirrored. Same blind-marketplace
// boundary as everywhere else: the retailer is shown only via anonHandle to
// suppliers, and a supplier is shown only via anonHandle back to the
// retailer, unless the viewer is Broker/Admin (see CLAUDE.md §18).
model ProductRequest {
  id         String   @id @default(cuid())
  retailerId String
  retailer   User     @relation("ProductRequestRetailer", fields: [retailerId], references: [id], onDelete: Cascade)

  category      String? // null = any category
  productName   String // free-text description of what's needed, e.g. "Trim, any strain"
  quantity      Float
  unit          String
  targetPrice   Float? // optional — retailer's target price/unit, null if open to offers
  termsPreference String? // cash | net_30 | negotiable | null
  note          String?

  status    String   @default("open") // open | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses ProductRequestResponse[]

  @@map("product_requests")
}

// A supplier's reply to a wanted-board request — optionally points at one
// of their own active Listings so the retailer can click through into the
// normal negotiation flow (getOrCreateThread/addOfferRound) rather than
// this app inventing a second deal-making state machine. No further
// back-and-forth here; that continues in the normal offer thread once the
// retailer engages with the linked listing (deliberately simple, same v1
// scope cut as SplitContract's single propose step below).
model ProductRequestResponse {
  id        String   @id @default(cuid())
  requestId String
  request   ProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   User    @relation("ProductRequestResponseSupplier", fields: [supplierId], references: [id], onDelete: Cascade)

  listingId String? // optional link to an existing matching listing
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  price     Float?
  quantity  Float?
  message   String

  createdAt DateTime @default(now())

  @@map("product_request_responses")
}

// Toll-processing agreement: a Processor sources raw material from a
// Grower's listing not for a flat price, but for a % share of the finished
// product's eventual value. One proposal per (listing, processor) pair — a
// grower listing can receive proposals from multiple processors, same
// pattern as OfferThread. Deliberately simpler than the price/terms
// negotiation state machine (single propose -> accept/reject, no counter
// loop) — a v1 scope cut, not an oversight.
//
// The platform never sets or takes a cut of the split — see CLAUDE.md's
// no-commission design. Physical pickup/transport for a settled contract is
// coordinated directly between grower and processor for now; wiring this
// into the existing Shipment/transporter flow is a deferred follow-up
// (same spirit as CLAUDE.md §8's other deferred items), not silently
// treated as solved.
//
// status: "proposed" | "accepted" | "rejected" | "processing" | "finished" | "settled"
model SplitContract {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  growerId    String
  grower      User @relation("SplitContractGrower", fields: [growerId], references: [id])
  processorId String
  processor   User @relation("SplitContractProcessor", fields: [processorId], references: [id])

  outputProduct  String
  splitGrowerPct Float
  note           String?

  status String @default("proposed")

  yieldQty  Float?
  yieldUnit String?

  settlementValue           Float?
  settlementGrowerAmount    Float?
  settlementProcessorAmount Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, processorId])
  @@index([status])
  @@map("split_contracts")
}

// type: "image" | "video"
model ListingMedia {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  // Experimental best-effort logo/contact-info removal — see
  // lib/media-redaction.ts and CLAUDE.md §18. NOT a guarantee: a missed
  // detection means the original content is still fully visible. Shown to
  // the seller as a "reviewed, double-check it" signal, not a promise.
  redactionAttempted     Boolean @default(false)
  redactionRegionsFound  Int     @default(0)
  redactionError         String?

  @@map("listing_media")
}

// ---------- Negotiation ----------
// One thread per (listing, retailer) pair. status: "open" | "accepted" | "rejected" | "expired"
model OfferThread {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  retailerId  String
  retailer    User     @relation("ThreadRetailer", fields: [retailerId], references: [id])

  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Added 2026-08-16 — optional per-negotiation expiration, independent of
  // the listing's own expiresAt. Null means no expiration (the retailer's
  // choice at the time they open the thread — see CLAUDE.md §18). Swept the
  // same lazy way as listing expiration (lib/offers.ts's expireStaleThreads,
  // called from every read path) rather than a background job.
  expiresAt DateTime?

  // View tracking, per side — powers the "X viewed your offer N times"
  // alert. Counts increment on every view (a reload counts as a view, same
  // as most view-counters); notifications for it are throttled separately
  // in lib/offers.ts so a reloading tab doesn't spam the other party.
  sellerViewCount      Int       @default(0)
  sellerLastViewedAt   DateTime?
  retailerViewCount    Int       @default(0)
  retailerLastViewedAt DateTime?

  rounds OfferRound[]
  deal   Deal?

  @@unique([listingId, retailerId])
  @@index([status])
  @@map("offer_threads")
}

// action: "counter" | "accept" | "reject"
// actorRole is denormalized ("retailer" | "seller") so anonymization logic
// never has to resolve actorId's real role for display to the other party.
model OfferRound {
  id        String   @id @default(cuid())
  threadId  String
  thread    OfferThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation("OfferRoundActor", fields: [actorId], references: [id])
  actorRole String

  action    String
  price     Float?
  quantity  Float?
  terms     String?
  message   String?

  // Added 2026-08-16 — who pays if the buyer later rejects the delivered
  // product, and at what rate. Negotiated exactly like price/quantity/terms
  // (most recent round's value wins at accept) — this is the buyer/seller's
  // own negotiated term, set during their own negotiation, NOT the broker's
  // call the way §11's commission is. If neither side ever proposes a rate,
  // no fee applies (see Deal.rejectionFeeRate's default). See CLAUDE.md §14.
  rejectionFeeRate  Float? // 0-100 (%), of deal value
  rejectionFeePayer String? // "grower" | "retailer" | "split"

  createdAt DateTime @default(now())

  @@map("offer_rounds")
}

// Created when a thread's status becomes "accepted". Holds both real
// identities — but per CLAUDE.md §3/§6, only broker-, admin-, and (once a
// Shipment exists) assigned-transporter-scoped queries are allowed to
// resolve sellerId/retailerId through to their real User records. The
// seller's and retailer's own deal views (src/lib/shipments.ts) query this
// same table but only ever render the *other* party through their
// anonHandle, never these relations directly.
model Deal {
  id         String   @id @default(cuid())
  threadId   String   @unique
  thread     OfferThread @relation(fields: [threadId], references: [id])
  listingId  String

  sellerId    String
  seller      User   @relation("DealSeller", fields: [sellerId], references: [id])
  retailerId  String
  retailer    User   @relation("DealRetailer", fields: [retailerId], references: [id])

  finalPrice    Float
  finalQuantity Float
  finalTerms    String

  // Resolved the same way as finalPrice — whatever was last on the table
  // when the deal was accepted. 0/"split" if the parties never discussed
  // it. See the OfferRound comment above and CLAUDE.md §14.
  rejectionFeeRate  Float  @default(0)
  rejectionFeePayer String @default("split")

  // Fulfillment: an invoice is auto-generated the moment the deal is
  // created (see lib/invoice.ts) so the retailer is never blocked waiting
  // on the grower; the grower can still upload their own file to override
  // it (invoiceAutoGenerated flips to false). Retailer reviews and accepts
  // it, which is what triggers transporter selection (see Shipment below).
  // Nothing here is legally a completed transfer — see CLAUDE.md §2.
  invoiceUrl           String?
  invoiceUploadedAt    DateTime?
  invoiceAcceptedAt    DateTime?
  invoiceAutoGenerated Boolean   @default(false)

  // Retailer's explicit accept/reject of the physically delivered product —
  // only actionable once the Shipment reaches "delivered". Accepting shows
  // a final-sale notice and is what triggers the commission amount to be
  // computed (see Commission below). Rejecting is recorded but this app
  // does NOT run a refund/return/dispute-resolution process — that's real-
  // world, Broker-mediated, same caveat as CLAUDE.md §2's transfer language.
  // status: "pending" | "accepted" | "rejected"
  productStatus     String    @default("pending")
  productDecisionAt DateTime?

  createdAt DateTime @default(now())

  shipment   Shipment?
  commission Commission?
  rejection  ProductRejection?
  salesRepCommission SalesRepCommission?

  @@map("deals")
}

// Tracks a Sales Rep's attributed sales and the commission earned on them —
// added 2026-08-16, see CLAUDE.md §18. Unlike Commission (broker-set,
// per-deal, any rate the broker chooses), a sales rep's rate is a standing
// structure Admin sets on their account (User.salesRepCommissionRate) and
// applies automatically to every deal that closes from a listing they
// created (Listing.createdBySalesRepId) — the rep doesn't negotiate it
// per-deal. Created lazily at product acceptance (see lib/commission.ts's
// acceptProduct), snapshotting the rep's rate at that moment so a later
// rate change doesn't retroactively alter an already-computed commission
// (same "computed once" posture as Commission).
model SalesRepCommission {
  id         String   @id @default(cuid())
  dealId     String   @unique
  deal       Deal     @relation(fields: [dealId], references: [id])
  salesRepId String
  salesRep   User     @relation(fields: [salesRepId], references: [id])

  rate   Float // % snapshot at time of computation
  amount Float // dealValue * rate/100, computed once

  status String    @default("pending") // pending | paid
  paidAt DateTime?

  createdAt DateTime @default(now())

  @@map("sales_rep_commissions")
}

// Added 2026-08-16 — a deliberate, confirmed extension of the "rejecting is
// only recorded, no in-app dispute process" stance from the Deal.productStatus
// comment above. The human asked for an actual post-rejection workflow, not
// just a recorded flag: the retailer states a reason and picks one of two
// paths — request the product be returned outright, or propose a revised
// price based on the delivered product's condition. The grower then either
// accepts the revised price (closes the deal at the new finalPrice) or
// insists on the return. Still a single round, no back-and-forth counter
// loop — same "deliberately simpler" scope cut as SplitContract. This is
// still NOT a refund/payment/return-shipping engine — the app tracks the
// resolution, it doesn't move money or arrange the physical return; that
// stays real-world/off-platform, same caveat as everywhere else (§2, §8).
// resolutionType: "return" | "counter_offer" (set when the retailer acts)
// status: "pending" | "counter_accepted" | "return_requested" | "return_approved"
model ProductRejection {
  id     String @id @default(cuid())
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id])

  reason String

  resolutionType String?
  counterPrice   Float?
  counterNote    String?

  status String @default("pending")

  // Computed at rejection time from Deal.rejectionFeeRate/rejectionFeePayer
  // — the rate/payer split was locked in during the original negotiation
  // (CLAUDE.md §14), not decided now. feeAmount is null when the deal's
  // rate is 0 (no fee was ever negotiated). Tracked, not processed — same
  // "this app never moves money" posture as Commission (§8/§11).
  feeAmount      Float?
  feeGrowerOwes  Float?
  feeRetailerOwes Float?
  feeStatus      String  @default("pending") // pending | paid | waived
  feePaidAt      DateTime?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@map("product_rejections")
}

// Broker-set commission on a Deal — see CLAUDE.md §10's explicit note that
// this reverses the platform's earlier no-commission stance, confirmed with
// the human on 2026-08-16 despite the still-open MI broker-licensing
// question in §2. Any broker (platform-wide visibility, see decision #2)
// can set or edit these terms on any deal; the dollar amount is computed
// once the retailer accepts the delivered product (Deal.productStatus ->
// "accepted"), then tracked to "paid" — this app never moves money itself,
// same as every other financial figure here (see CLAUDE.md §8).
// payerType: "grower" | "retailer" | "split"
// status: "pending" | "paid"
model Commission {
  id            String @id @default(cuid())
  dealId        String @unique
  deal          Deal   @relation(fields: [dealId], references: [id])
  setByBrokerId String
  setByBroker   User   @relation(fields: [setByBrokerId], references: [id])

  rate           Float // 0-100 (%), fully custom broker discretion
  payerType      String
  splitGrowerPct Float? // only meaningful when payerType == "split"

  amount       Float? // total commission $, computed on product acceptance
  growerOwes   Float?
  retailerOwes Float?

  status String    @default("pending")
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commissions")
}

// One shipment per accepted+invoiced Deal. Created the moment the retailer
// accepts the invoice and picks a transporter (see CLAUDE.md §3 update on
// transporters). status: "assigned" | "picked_up" | "in_transit" | "delivered".
model Shipment {
  id            String @id @default(cuid())
  dealId        String @unique
  deal          Deal   @relation(fields: [dealId], references: [id])
  transporterId String
  transporter   User   @relation("ShipmentTransporter", fields: [transporterId], references: [id])

  status  String  @default("assigned")
  podUrl  String? // proof-of-delivery photo/signature, uploaded by the transporter on delivery

  // Added 2026-08-16 — the transporter proposes a pickup/delivery window,
  // and both the grower and retailer have to explicitly accept it before the
  // transporter can move the shipment past "assigned" into "picked_up" (see
  // NEXT_SHIPMENT_STATUS in lib/constants.ts / advanceShipmentStatus in
  // lib/shipments.ts). Re-proposing a new time (transporter changes either
  // date) resets both acceptance flags — an old "yes" shouldn't silently
  // apply to a new time nobody actually agreed to.
  scheduledPickupAt        DateTime?
  scheduledDeliveryAt      DateTime?
  growerAcceptedSchedule   Boolean   @default(false)
  retailerAcceptedSchedule Boolean   @default(false)

  // Added 2026-08-16 — the transporter's own fee for hauling this shipment,
  // separate from both the deal's price (grower/retailer) and the broker's
  // commission (§11). The transporter sets the amount and who pays it
  // (grower/retailer/split) once, then uploads or the app generates a
  // simple invoice — tracked, not processed, same "this app never moves
  // money" posture as everything else (§8/§11/§14). See CLAUDE.md §18.
  transportFeeAmount         Float?
  transportFeePayer          String? // "grower" | "retailer" | "split"
  transportFeeSplitGrowerPct Float?
  transportInvoiceUrl        String?
  transportFeeStatus         String  @default("pending") // pending | paid
  transportFeePaidAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ShipmentEvent[]

  @@map("shipments")
}

// Status timeline, logged by the transporter as they update the shipment —
// this is the "tracking" the grower/retailer/broker see.
model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status String
  note   String?

  createdAt DateTime @default(now())

  @@map("shipment_events")
}

// ---------- POS integration scaffolding (added 2026-08-16) ----------
// Requested: push accepted deals into a seller's existing POS (Dutchie,
// Treez, Flowhub, or Cova). All four require becoming a certified/approved
// API partner with that vendor — a business relationship, not just an API
// key a user pastes in — which hasn't happened yet, so there is NO live
// vendor API call anywhere in this codebase. What's built is the
// architecture: a connection record, a common adapter interface
// (lib/pos-integration.ts), and a sync log — every "sync" today produces a
// PosSyncLog row honestly marked stubOnly, not a faked success. See
// CLAUDE.md §18 — don't wire a real vendor call in without real, verified
// partner credentials and current API docs for that vendor.
model PosConnection {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])
  vendor  String // "dutchie" | "treez" | "flowhub" | "cova"
  apiKey  String // NOT encrypted at rest yet — see CLAUDE.md §8-style deferred note in §18
  autoSyncEnabled Boolean @default(false)
  connectedAt     DateTime @default(now())

  syncLogs PosSyncLog[]

  @@map("pos_connections")
}

model PosSyncLog {
  id             String        @id @default(cuid())
  connectionId   String
  connection     PosConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  dealId         String?
  vendor         String
  status         String // "stub_only" | "failed" — never "synced" until a real adapter exists
  message        String
  createdAt      DateTime      @default(now())

  @@map("pos_sync_logs")
}

// ---------- METRC connection scaffolding (added 2026-08-16, second ask) ----------
// SCAFFOLDING ONLY — see lib/metrc-integration.ts. No live METRC API call is
// made anywhere in this codebase yet. CLAUDE.md §2 flags that it isn't
// established whether "Broker" (this platform's core role, full visibility
// into every deal) is a recognized MI license category for wholesale
// transfers — connecting real METRC credentials starts operationally
// treating this platform as part of the compliance chain, which is exactly
// that unresolved question. These models exist so the connection UI is
// ready the moment real API access + legal review land, same "recommend,
// don't act autonomously" posture as everywhere else AI/automation touches
// this app. Do not wire live manifest/transfer calls without both.
model MetrcConnection {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber String?
  userApiKey    String // NOT encrypted at rest yet — same deferred-hardening note as PosConnection.apiKey
  connectedAt   DateTime @default(now())

  @@map("metrc_connections")
}

// Singleton — the platform's own METRC "software vendor" API key (issued by
// METRC to a registered software integrator, used alongside each licensee's
// own MetrcConnection.userApiKey). Admin-only.
model MetrcVendorConfig {
  id           String   @id @default("singleton")
  vendorApiKey String?
  updatedAt    DateTime @updatedAt

  @@map("metrc_vendor_config")
}

// ---------- Statewide monthly market report (added 2026-08-16) ----------
// Michigan's Cannabis Regulation Agency (CRA) publishes an official monthly
// report (Medical + Adult-Use programs) with statewide sales-by-category,
// sales-by-region, active license counts, and average retail flower price.
// The human uploads that .docx every month (Admin-only, see
// lib/monthly-report.ts) and it's parsed into this table so every portal
// can show real statewide market context alongside this platform's own
// internal Market Pulse (lib/market.ts, which only reflects this
// platform's own listings/deals — a much smaller sample). This is public
// state regulatory data, not anything about this platform's own users.
model MonthlyMarketReport {
  id             String   @id @default(cuid())
  reportMonth    DateTime @unique // normalized to the 1st of the month
  reportLabel    String // "July 2026"
  sourceFileName String?
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  uploadedAt     DateTime @default(now())

  // Headline Adult-Use (recreational) figures — the program this platform's
  // wholesale market actually operates under. Denormalized onto the row for
  // fast trend queries without unpacking the JSON blobs below every time.
  auTotalSales                Float?
  auTotalPoundsSold            Float?
  auAvgRetailFlowerPricePerOz Float?
  auSalesToDate                Float?
  auActiveLicensesTotal        Int?

  // Same headline figures for the Medical program, for context.
  medTotalSales                Float?
  medTotalPoundsSold           Float?
  medAvgRetailFlowerPricePerOz Float?

  // Full structured breakdown — category × {poundsSold, flOzSold,
  // totalSales} for both programs, plus the 5-region breakdown and active
  // license counts by license type. Kept as JSON rather than one column per
  // cell: the report has ~10 product categories × 5 regions × 2 programs,
  // and Claude doesn't control this document's shape — modeling every cell
  // as a dedicated migration would be unmaintainable churn.
  auCategoryBreakdown   Json?
  medCategoryBreakdown  Json?
  auRegionalBreakdown   Json?
  medRegionalBreakdown  Json?
  activeLicensesByType  Json?

  // Fallback dump of whatever text the parser pulled from the .docx, so a
  // human can eyeball what didn't map cleanly to a field above.
  rawExtractedText String?

  @@map("monthly_market_reports")
}

// ---------- License registry (added 2026-08-16) ----------
// Imported from the state of Michigan's CRA licensee exports (5 category
// files: Class B/C Grower, Processor, Retailer, Secure Transporter — no
// "Broker" category exists in the state data, consistent with CLAUDE.md §2's
// still-open question). Looked up by license number at signup to
// auto-populate business name/address and, on an "active" match, skip the
// manual Admin queue — see lib/license-registry.ts for the matching and
// auto-approval logic, and CLAUDE.md §12 for the honesty tradeoff this
// implies (a license *number* match isn't proof of who's typing it in).
model LicenseRegistry {
  id             String    @id @default(cuid())
  licenseNumber  String    @unique
  category       String // grower_b | grower_c | processor | retailer | transporter
  recordType     String? // state's own label, e.g. "Class C Marihuana Grower - License"
  businessName   String
  street         String?
  city           String?
  state          String?
  zip            String?
  status         String // state's raw status string, e.g. "Active", "License Void"
  expirationDate DateTime?
  hasDisciplinaryAction Boolean @default(false)

  // Phone/contact enrichment merged in from the platform owner's own lead
  // list, matched by normalized business name (the two datasets use
  // different license-number schemes, so name is the only reliable join key
  // — see the merge note in scripts/import-license-registry.mjs). Null when
  // no match was found; state data alone still covers name/address/status.
  phone String?

  importedAt DateTime @default(now())

  @@index([businessName])
  @@map("license_registry")
}
