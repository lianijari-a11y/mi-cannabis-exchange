// MI Cannabis Exchange — Prisma schema
// Postgres (Supabase) — see CLAUDE.md §7. Started on SQLite for zero-setup
// local dev; moved to hosted Postgres once a project was provisioned.
// role/category/status fields stayed plain Strings (not native Postgres
// enums) rather than churn every model now that a real enum type is
// available — valid values are enforced in application code, see
// src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Core identity ----------
// role: "grower" | "processor" | "retailer" | "broker" | "transporter" | "admin"
model User {
  id           String   @id @default(cuid())
  role         String
  email        String   @unique
  passwordHash String
  fullName     String
  businessName String?

  // Pickup/delivery address — grower/processor/retailer fill this in at
  // signup so a Shipment has somewhere to route to. Not collected for
  // broker/transporter/admin.
  address String?
  city    String?
  state   String?
  zip     String?

  // Geocoded from the free-text address above via lib/geocoding.ts
  // (Google Geocoding API, gated behind GOOGLE_MAPS_API_KEY — same "not
  // configured" honest-fallback posture as every other optional external
  // API in this app). Null until a geocode attempt actually succeeds;
  // geocodedAt lets a caller tell "never attempted" apart from "attempted
  // and failed" isn't tracked separately — both just leave lat/lng null.
  // Feeds real transporter routing/ETA once that's built, and a validated
  // address is useful on its own regardless.
  addressLat  Float?
  addressLng  Float?
  geocodedAt  DateTime?

  // License fields — grower/processor/retailer/transporter only (MI's Secure
  // Transporter license, same licensing tier as the others). Verified by
  // Admin, never auto-verified (no MI equivalent of FMCSA SAFER exists yet,
  // see CLAUDE.md §8).
  licenseNumber       String?
  licenseType         String?
  licenseVerification String  @default("unverified") // unverified | approved | rejected
  licenseExpiry       DateTime? // shown in Admin's license expiration alerts
  phone               String?

  // True when licenseVerification was set to "approved" automatically by
  // matching licenseNumber against LicenseRegistry at signup, rather than by
  // an Admin manually reviewing it. Admin UI shows this distinctly so a real
  // person can still audit/revoke a match — see CLAUDE.md §12.
  licenseAutoMatched Boolean @default(false)

  // True when an Admin/AE chose this account's current password on the
  // user's behalf (a quick-signup temp password, or a password reset) —
  // set by createRetailerAccountForAdmin/resetUserPassword, cleared once
  // the person actually sets their own password. Drives the license-first
  // inline sign-in flow on a public menu/collection link
  // (components/cart/license-auth-flow.tsx): a retailer whose account was
  // set up for them gets prompted to choose a real password instead of
  // being asked for the temporary one nobody expects them to remember.
  mustChangePassword Boolean @default(false)

  // Platform owner's default transporter, pre-selected (but overridable) when
  // a retailer picks who ships their deal. Admin-only toggle. Only meaningful
  // for role = transporter.
  preferredTransporter Boolean @default(false)

  // Admin-set standing commission rate for a Sales Rep, applied automatically
  // to every deal closed from a listing they created — see
  // SalesRepCommission below and CLAUDE.md §18. Only meaningful for
  // role = sales_rep. Null/0 means no commission is computed.
  salesRepCommissionRate Float?

  // Retailer POS (CLAUDE.md §23) — prefills the markup field when converting
  // an accepted Deal into inventory (lib/pos.ts's createInventoryLotFromDeal),
  // still editable per lot. Only meaningful for role = retailer.
  defaultMarkupPercent Float?


  // Public order-ahead storefront (CLAUDE.md §25) — retailer-set, URL-safe
  // slug used in /order/<slug>. Deliberately NOT derived from or related to
  // anonHandle: anonHandle exists to hide identity across the wholesale
  // blind-marketplace boundary; this is the opposite — a retailer's own
  // real business identity, meant to be shared publicly. Only meaningful
  // for role = retailer.
  storefrontSlug String? @unique

  // Register customer/loyalty features — both plain editable numbers, not
  // certified lookups, same posture as the tax-rate field on Sale. Only
  // meaningful for role = retailer.
  // - loyaltyPointsPerDollar: points accrued per $1 of a completed sale
  //   (null/0 means loyalty accrual is off for this retailer).
  // - dailyPurchaseLimitOz: the flower-equivalent daily purchase limit shown
  //   on the register's purchase-limit bar — see lib/customers.ts's
  //   todaysFlowerEquivalentOz for what "flower-equivalent" does and does
  //   not cover.
  loyaltyPointsPerDollar Float?
  dailyPurchaseLimitOz   Float?

  // Budtender staff accounts (CLAUDE.md §33) — created by a Retailer to
  // operate Xcelerate POS only, never the wholesale marketplace. Only set
  // for role = budtender; points back at the Retailer whose inventory,
  // customers, and sales they act on. Cascade delete: a budtender account
  // has no meaning once its owning Retailer is gone.
  retailerOwnerId String?
  retailerOwner   User?   @relation("RetailerStaff", fields: [retailerOwnerId], references: [id], onDelete: Cascade)
  staff           User[]  @relation("RetailerStaff")

  // Exclusive Account Executive assignment (CLAUDE.md §38) — once any Sales
  // Rep first works with a Grower/Processor (creates their account, or posts
  // a listing for an unassigned one), that seller is locked to them; no
  // other Sales Rep can post/edit for that seller after that. Only
  // meaningful for role = grower/processor. Null means unclaimed — the next
  // Sales Rep to work with them claims it. Admin is intentionally exempt
  // from this lock (same unrestricted-reach posture as everywhere else
  // Admin operates) — this is an AE-to-AE exclusivity rule, not an
  // AE-vs-Admin one. SetNull on delete: removing a Sales Rep account
  // shouldn't orphan-delete the growers they worked with, just free them up.
  assignedSalesRepId String?
  assignedSalesRep   User?   @relation("SalesRepAssignment", fields: [assignedSalesRepId], references: [id], onDelete: SetNull)
  assignedSellers    User[]  @relation("SalesRepAssignment")

  // Stable anonymous handle shown to the counterparty across the blind
  // marketplace boundary, e.g. "Grower #A17". Generated once at signup,
  // never derived from the real name so it can't leak identity. Transporters
  // get one too for consistency, but their real business name is always
  // shown — transport identity isn't part of the grower/retailer blind
  // boundary, see CLAUDE.md §3/§10.
  anonHandle String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings           Listing[]       @relation("ListingPostedBy")
  listingsCreatedAsSalesRep Listing[] @relation("ListingCreatedBySalesRep")
  offerRoundsMade    OfferRound[]    @relation("OfferRoundActor")
  retailerThreads    OfferThread[]   @relation("ThreadRetailer")
  dealsAsSeller      Deal[]          @relation("DealSeller")
  dealsAsRetailer    Deal[]          @relation("DealRetailer")
  shipmentsHauled    Shipment[]      @relation("ShipmentTransporter")
  watchlistEntries   Watchlist[]
  listingDismissals  ListingDismissal[]
  splitContractsAsGrower    SplitContract[] @relation("SplitContractGrower")
  splitContractsAsProcessor SplitContract[] @relation("SplitContractProcessor")
  notifications      Notification[]
  commissionsSet      Commission[]
  monthlyReportsUploaded MonthlyMarketReport[]
  posConnection          PosConnection?
  agreementAcceptances   AgreementAcceptance[]
  productRequests            ProductRequest[]         @relation("ProductRequestRetailer")
  productRequestResponsesSent ProductRequestResponse[] @relation("ProductRequestResponseSupplier")
  salesRepCommissionsEarned  SalesRepCommission[]
  metrcConnection            MetrcConnection?
  inventoryLots              InventoryLot[]
  sales                      Sale[]
  saleCounter                SaleCounter?
  customers                  Customer[]
  ordersReceived             Order[]
  smsConnection              SmsConnection?
  marketingMessages          MarketingMessage[]
  menuCollectionsCreated     MenuCollection[]
  cartOrdersPlaced           CartOrder[]
  passwordResetTokens        PasswordResetToken[]
  assignedLeads              Lead[]
  leadMessageCampaigns       LeadMessageCampaign[] @relation("LeadCampaignCreatedBy")
  aiNegotiationMandates      AiNegotiationMandate[] @relation("AiNegotiationMandateParty")
  brokerSuggestions          BrokerSuggestion[]     @relation("BrokerSuggestionBroker")

  @@index([retailerOwnerId])
  @@index([assignedSalesRepId])
  @@map("users")
}

// Self-service "forgot password" (CLAUDE.md — no email-sending infra
// existed at all until this shipped; see lib/email.ts). A token is a
// single-use, time-limited credential: requesting a new one doesn't
// invalidate an older still-valid one on its own, but usedAt on any token
// prevents a replay, and the request flow always mints a fresh row rather
// than reusing one. Stored hashed (sha256, deterministic — a reset link
// only needs to be looked up by exact match, not brute-force-resistant
// bcrypt) so a raw DB read can't hand out a live reset credential.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Records that a user clicked "I agree" on a given agreement, at a given
// version, at a given time — currently used for the platform-wide
// non-circumvention agreement (see CLAUDE.md §18). One row per
// (user, agreementType): accepting again after a version bump overwrites
// the prior row rather than keeping history, since all that ever matters
// for gating access is "did they accept the *current* version." The
// underlying legal text is a placeholder pending review by an actual MI
// cannabis attorney (same posture as CLAUDE.md §9's legal-template-content
// caveat) — this model only tracks the click, it isn't itself the contract.
model AgreementAcceptance {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreementType String // "non_circumvent"
  version       String
  acceptedAt    DateTime @default(now())

  @@unique([userId, agreementType])
  @@map("agreement_acceptances")
}

// In-app only — no SMS/push, see CLAUDE.md §8. type is a free-form tag
// ("offer_viewed", "offer_countered", ...) used for icon/routing choices in
// the UI, not enforced at the DB layer.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  threadId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ---------- Listings ----------
// category: "flower" | "concentrate" | "vape" | "edible" | "pre_roll" | "other"
// unit: "lb" | "liter" | "unit"
// terms: "cash" | "net_30" | "negotiable"
// status: "active" | "expired" | "closed" (closed = a Deal was made)
model Listing {
  id          String   @id @default(cuid())
  postedById  String
  postedBy    User     @relation("ListingPostedBy", fields: [postedById], references: [id])

  // Set when a Sales Rep built this listing on behalf of postedById (see
  // lib/sales-actions.ts) instead of the seller posting it themselves —
  // postedById is still the real Grower/Processor, so anonymization and
  // ownership work exactly the same either way; this is purely an audit
  // trail of who actually did the data entry. Never shown to buyers.
  createdBySalesRepId String?
  createdBySalesRep   User?   @relation("ListingCreatedBySalesRep", fields: [createdBySalesRepId], references: [id])

  // Groups every Listing created in one form submission into a single
  // "menu" — a seller who posts one strain at a time gets a menu of 1, a
  // bulk price-list import gets one menu with all N strains in it, and a
  // seller who bulk-imports again next week gets a SECOND, separate menu.
  // Generated once per submission (lib/listings.ts's createListing) and
  // stamped on every row that submission creates — never reused across two
  // separate submissions, even from the same seller. Nullable only because
  // listings created before this field existed don't have one; see
  // scripts/backfill-listing-batches.mjs for how those were inferred.
  batchId String?

  strainName  String
  category    String
  thcPercent  Float?
  quantity    Float
  unit        String
  pricePerUnit Float
  terms       String
  notes       String?

  // Tiered wholesale pricing (CLAUDE.md §40) — a soft threshold, not a hard
  // reject: a grower can still sell below their preferred order size, just
  // at a different (typically higher) per-unit price. pricePerUnit above
  // is what applies at minimumOrderQuantity or more; belowMinimumPricePerUnit
  // applies to anything smaller. Both null/unset means no tiering at all —
  // pricePerUnit is simply the price regardless of quantity, same as
  // before this existed. Set by the grower/processor themselves, plain
  // editable numbers like every other price field here, not a certified
  // pricing engine.
  minimumOrderQuantity     Float?
  belowMinimumPricePerUnit Float?

  status    String   @default("active")
  expiresAt DateTime?

  // Distribution control — added 2026-08-16, a deliberate, confirmed
  // reversal of the original "every listing visible to every retailer,
  // nothing platform-gated" rule (CLAUDE.md decision #3). Same posture as
  // §11's commission reversal: not a silent decision, flagged and
  // explicitly confirmed. "all" (default) preserves the original bulletin-
  // board behavior; "exclusive" restricts visibility to exclusiveRetailerIds,
  // set by Admin. See CLAUDE.md §18.
  visibility           String   @default("all") // "all" | "exclusive"
  exclusiveRetailerIds String[] @default([])

  // Bumped by the seller's one-click "still available" confirmation
  // (lib/listings.ts's confirmListingFresh) or by any edit to the listing.
  // Feed sort offers a "recently confirmed" option and the seller dashboard
  // flags anything stale — see CLAUDE.md §13. Never used to gate or hide a
  // listing from the feed, only to inform.
  lastConfirmedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media   ListingMedia[]
  threads OfferThread[]
  watchlistedBy  Watchlist[]
  dismissedBy    ListingDismissal[]
  splitContracts SplitContract[]
  productRequestResponses ProductRequestResponse[]

  @@index([status])
  @@index([batchId])
  @@map("listings")
}

// A retailer tracking a listing they haven't (yet) made an offer on.
model Watchlist {
  id         String   @id @default(cuid())
  retailerId String
  retailer   User     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([retailerId, listingId])
  @@map("watchlist_entries")
}

// A retailer marking a listing "Not interested" — same shape as Watchlist,
// opposite intent: hides it from that retailer's own feed only (never
// affects what anyone else sees, and never affects the listing itself).
// Reversible from the retailer's dismissed-listings view.
model ListingDismissal {
  id         String   @id @default(cuid())
  retailerId String
  retailer   User     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([retailerId, listingId])
  @@map("listing_dismissals")
}

// "Wanted board" — a retailer posts a product they need that isn't
// currently listed; visible to Growers/Processors/Brokers the same way a
// Listing is visible to Retailers, just mirrored. Same blind-marketplace
// boundary as everywhere else: the retailer is shown only via anonHandle to
// suppliers, and a supplier is shown only via anonHandle back to the
// retailer, unless the viewer is Broker/Admin (see CLAUDE.md §18).
model ProductRequest {
  id         String   @id @default(cuid())
  retailerId String
  retailer   User     @relation("ProductRequestRetailer", fields: [retailerId], references: [id], onDelete: Cascade)

  category      String? // null = any category
  productName   String // free-text description of what's needed, e.g. "Trim, any strain"
  quantity      Float
  unit          String
  targetPrice   Float? // optional — retailer's target price/unit, null if open to offers
  termsPreference String? // cash | net_30 | negotiable | null
  note          String?

  status    String   @default("open") // open | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses ProductRequestResponse[]

  @@map("product_requests")
}

// A supplier's reply to a wanted-board request — optionally points at one
// of their own active Listings so the retailer can click through into the
// normal negotiation flow (getOrCreateThread/addOfferRound) rather than
// this app inventing a second deal-making state machine. No further
// back-and-forth here; that continues in the normal offer thread once the
// retailer engages with the linked listing (deliberately simple, same v1
// scope cut as SplitContract's single propose step below).
model ProductRequestResponse {
  id        String   @id @default(cuid())
  requestId String
  request   ProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   User    @relation("ProductRequestResponseSupplier", fields: [supplierId], references: [id], onDelete: Cascade)

  listingId String? // optional link to an existing matching listing
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  price     Float?
  quantity  Float?
  message   String

  createdAt DateTime @default(now())

  @@map("product_request_responses")
}

// Toll-processing agreement: a Processor sources raw material from a
// Grower's listing not for a flat price, but for a % share of the finished
// product's eventual value. One proposal per (listing, processor) pair — a
// grower listing can receive proposals from multiple processors, same
// pattern as OfferThread. Deliberately simpler than the price/terms
// negotiation state machine (single propose -> accept/reject, no counter
// loop) — a v1 scope cut, not an oversight.
//
// The platform never sets or takes a cut of the split — see CLAUDE.md's
// no-commission design. Physical pickup/transport for a settled contract is
// coordinated directly between grower and processor for now; wiring this
// into the existing Shipment/transporter flow is a deferred follow-up
// (same spirit as CLAUDE.md §8's other deferred items), not silently
// treated as solved.
//
// status: "proposed" | "accepted" | "rejected" | "processing" | "finished" | "settled"
model SplitContract {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  growerId    String
  grower      User @relation("SplitContractGrower", fields: [growerId], references: [id])
  processorId String
  processor   User @relation("SplitContractProcessor", fields: [processorId], references: [id])

  outputProduct  String
  splitGrowerPct Float
  note           String?

  status String @default("proposed")

  yieldQty  Float?
  yieldUnit String?

  settlementValue           Float?
  settlementGrowerAmount    Float?
  settlementProcessorAmount Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, processorId])
  @@index([status])
  @@map("split_contracts")
}

// type: "image" | "video"
model ListingMedia {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  // Experimental best-effort logo/contact-info removal — see
  // lib/media-redaction.ts and CLAUDE.md §18. NOT a guarantee: a missed
  // detection means the original content is still fully visible. Shown to
  // the seller as a "reviewed, double-check it" signal, not a promise.
  redactionAttempted     Boolean @default(false)
  redactionRegionsFound  Int     @default(0)
  redactionError         String?

  @@map("listing_media")
}

// A Sales Rep bundling several menus (each its own bulk-upload batch,
// possibly from different growers they're assigned to) into one shareable
// link (CLAUDE.md §40) — "an account rep has 14 menus from 14 different
// growers, all 14 can be grouped and shared with one link." Purely a
// browse-time grouping: batchIds is a plain list, not a foreign-keyed
// join table, since a "menu" isn't its own row anywhere else either (see
// Listing.batchId's comment) — this is consistent with that same
// lightweight-grouping approach rather than inventing two different
// patterns for the same idea.
model MenuCollection {
  id           String   @id @default(cuid())
  salesRepId   String
  salesRep     User     @relation(fields: [salesRepId], references: [id])
  batchIds     String[]
  createdAt    DateTime @default(now())

  cartOrders CartOrder[]

  @@map("menu_collections")
}

// Groups the several OfferThreads created from one multi-product cart
// submission (CLAUDE.md §40) — a retailer opening a menu or collection
// link, picking quantities across multiple products, and submitting once.
// This is purely an organizational wrapper: each resulting OfferThread
// still negotiates completely independently (accept/counter/reject one
// line item without affecting the others), same Broker visibility, same
// Deal/invoice/shipment machinery, nothing duplicated. See
// OfferThread.cartOrderId's comment.
model CartOrder {
  id           String   @id @default(cuid())
  retailerId   String
  retailer     User     @relation(fields: [retailerId], references: [id])

  // The collection link this order was placed from, if any (a cart order
  // can also come from picking multiple products off one grower's own
  // menu link, with no collection involved).
  collectionId String?
  collection   MenuCollection? @relation(fields: [collectionId], references: [id])

  // What the retailer requested for every line in this cart — defaults to
  // "cash" in the UI for smaller orders per the human's confirmed rule,
  // but nothing here forces that: the seller on each individual line still
  // has to actually accept these terms (or counter back to cash) through
  // the ordinary per-thread negotiation, exactly like any other offer.
  // This field is just what was originally requested, for reference.
  requestedTerms String

  // A Sales Rep facilitating this cart order (relaying it from a retailer
  // who called them, same posture as every other AE-assisted flow in this
  // app) must have the liability disclaimer shown and acknowledged before
  // submitting — see components/cart/terms-disclaimer.tsx. Null when no
  // AE was involved (the retailer submitted it themselves).
  facilitatedBySalesRepId String?
  disclaimerAcknowledgedAt DateTime?

  createdAt DateTime @default(now())

  threads OfferThread[]

  @@map("cart_orders")
}

// ---------- Negotiation ----------
// One thread per (listing, retailer) pair. status: "open" | "accepted" | "rejected" | "expired"
model OfferThread {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  retailerId  String
  retailer    User     @relation("ThreadRetailer", fields: [retailerId], references: [id])

  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Added 2026-08-16 — optional per-negotiation expiration, independent of
  // the listing's own expiresAt. Null means no expiration (the retailer's
  // choice at the time they open the thread — see CLAUDE.md §18). Swept the
  // same lazy way as listing expiration (lib/offers.ts's expireStaleThreads,
  // called from every read path) rather than a background job.
  expiresAt DateTime?

  // View tracking, per side — powers the "X viewed your offer N times"
  // alert. Counts increment on every view (a reload counts as a view, same
  // as most view-counters); notifications for it are throttled separately
  // in lib/offers.ts so a reloading tab doesn't spam the other party.
  sellerViewCount      Int       @default(0)
  sellerLastViewedAt   DateTime?
  retailerViewCount    Int       @default(0)
  retailerLastViewedAt DateTime?

  // Set when this thread was opened as one line item of a multi-product
  // cart order (CLAUDE.md §40) rather than a standalone single-listing
  // offer — purely a grouping label for UI purposes. Every existing
  // per-thread mechanic (accept/counter/reject, Deal creation, Broker
  // visibility, notifications) is completely unchanged and still operates
  // independently per thread; a cart order is several ordinary threads
  // that happen to share this id, not a new state machine.
  cartOrderId String?
  cartOrder   CartOrder? @relation(fields: [cartOrderId], references: [id])

  // Added for AI-assisted negotiation — set when AI's mandate on this thread
  // is exhausted (round cap hit, or the next move would have to cross a
  // party's walk-away price) without reaching a deal. A human Broker takes
  // over from here; AI never acts on this thread again once flagged. See
  // lib/ai-negotiation.ts.
  needsBrokerMediation Boolean   @default(false)
  mediationFlaggedAt   DateTime?

  rounds            OfferRound[]
  deal              Deal?
  mandates          AiNegotiationMandate[]
  brokerSuggestions BrokerSuggestion[]

  @@unique([listingId, retailerId])
  @@index([status])
  @@index([cartOrderId])
  @@map("offer_threads")
}

// action: "counter" | "accept" | "reject"
// actorRole is denormalized ("retailer" | "seller") so anonymization logic
// never has to resolve actorId's real role for display to the other party.
model OfferRound {
  id        String   @id @default(cuid())
  threadId  String
  thread    OfferThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation("OfferRoundActor", fields: [actorId], references: [id])
  actorRole String

  action    String
  price     Float?
  quantity  Float?
  terms     String?
  message   String?

  // Added 2026-08-16 — who pays if the buyer later rejects the delivered
  // product, and at what rate. Negotiated exactly like price/quantity/terms
  // (most recent round's value wins at accept) — this is the buyer/seller's
  // own negotiated term, set during their own negotiation, NOT the broker's
  // call the way §11's commission is. If neither side ever proposes a rate,
  // no fee applies (see Deal.rejectionFeeRate's default). See CLAUDE.md §14.
  rejectionFeeRate  Float? // 0-100 (%), of deal value
  rejectionFeePayer String? // "grower" | "retailer" | "split"

  // True only when lib/ai-negotiation.ts's runAiNegotiationStep submitted
  // this round on a party's behalf under an active AiNegotiationMandate —
  // never true for a human-submitted round. Always shown in the UI, never
  // used to disguise an AI decision as a human one.
  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("offer_rounds")
}

// A party's (retailer or seller) standing authorization for AI to negotiate
// on their behalf on one specific open thread, within an explicit price
// range they set themselves. One per party per thread — both sides of the
// same thread can have their own independent mandate. See
// lib/ai-negotiation.ts for the full engine; this table is just the
// authorization + range + round-budget record.
model AiNegotiationMandate {
  id       String @id @default(cuid())
  threadId String
  thread   OfferThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  partyRole String // "retailer" | "seller"
  partyId   String
  party     User   @relation("AiNegotiationMandateParty", fields: [partyId], references: [id])

  // Retailer: opening (low) offer, walk-away = ceiling they'll pay
  // (walkAwayPrice >= openingPrice). Seller: opening (high) offer,
  // walk-away = floor they'll accept (walkAwayPrice <= openingPrice).
  // Direction validated in lib/ai-negotiation.ts, not here.
  openingPrice  Float
  walkAwayPrice Float

  roundsUsed Int     @default(0)
  maxRounds  Int     @default(5)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([threadId, partyRole])
  @@index([threadId])
  @@map("ai_negotiation_mandates")
}

// A Broker's proposed compromise price on a thread flagged
// needsBrokerMediation — deliberately NOT a new negotiation-write path for
// Broker (see lib/broker-mediation.ts): it's a suggestion rendered to both
// parties, who each submit their own real OfferRound through the existing
// human accept/counter flow if they want to act on it. Broker never writes
// to OfferThread/OfferRound directly.
model BrokerSuggestion {
  id       String @id @default(cuid())
  threadId String
  thread   OfferThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  brokerId String
  broker   User   @relation("BrokerSuggestionBroker", fields: [brokerId], references: [id])

  suggestedPrice Float
  message        String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([threadId])
  @@map("broker_suggestions")
}

// Created when a thread's status becomes "accepted". Holds both real
// identities — but per CLAUDE.md §3/§6, only broker-, admin-, and (once a
// Shipment exists) assigned-transporter-scoped queries are allowed to
// resolve sellerId/retailerId through to their real User records. The
// seller's and retailer's own deal views (src/lib/shipments.ts) query this
// same table but only ever render the *other* party through their
// anonHandle, never these relations directly.
model Deal {
  id         String   @id @default(cuid())
  threadId   String   @unique
  thread     OfferThread @relation(fields: [threadId], references: [id])
  listingId  String

  sellerId    String
  seller      User   @relation("DealSeller", fields: [sellerId], references: [id])
  retailerId  String
  retailer    User   @relation("DealRetailer", fields: [retailerId], references: [id])

  finalPrice    Float
  finalQuantity Float
  finalTerms    String

  // Resolved the same way as finalPrice — whatever was last on the table
  // when the deal was accepted. 0/"split" if the parties never discussed
  // it. See the OfferRound comment above and CLAUDE.md §14.
  rejectionFeeRate  Float  @default(0)
  rejectionFeePayer String @default("split")

  // Fulfillment: an invoice is auto-generated the moment the deal is
  // created (see lib/invoice.ts) so the retailer is never blocked waiting
  // on the grower; the grower can still upload their own file to override
  // it (invoiceAutoGenerated flips to false). Retailer reviews and accepts
  // it, which is what triggers transporter selection (see Shipment below).
  // Nothing here is legally a completed transfer — see CLAUDE.md §2.
  invoiceUrl           String?
  invoiceUploadedAt    DateTime?
  invoiceAcceptedAt    DateTime?
  invoiceAutoGenerated Boolean   @default(false)

  // Retailer's explicit accept/reject of the physically delivered product —
  // only actionable once the Shipment reaches "delivered". Accepting shows
  // a final-sale notice and is what triggers the commission amount to be
  // computed (see Commission below). Rejecting is recorded but this app
  // does NOT run a refund/return/dispute-resolution process — that's real-
  // world, Broker-mediated, same caveat as CLAUDE.md §2's transfer language.
  // status: "pending" | "accepted" | "rejected"
  productStatus     String    @default("pending")
  productDecisionAt DateTime?

  createdAt DateTime @default(now())

  shipment   Shipment?
  commission Commission?
  rejection  ProductRejection?
  salesRepCommission SalesRepCommission?
  inventoryLot       InventoryLot?

  @@map("deals")
}

// Tracks a Sales Rep's attributed sales and the commission earned on them —
// added 2026-08-16, see CLAUDE.md §18. Unlike Commission (broker-set,
// per-deal, any rate the broker chooses), a sales rep's rate is a standing
// structure Admin sets on their account (User.salesRepCommissionRate) and
// applies automatically to every deal that closes from a listing they
// created (Listing.createdBySalesRepId) — the rep doesn't negotiate it
// per-deal. Created lazily at product acceptance (see lib/commission.ts's
// acceptProduct), snapshotting the rep's rate at that moment so a later
// rate change doesn't retroactively alter an already-computed commission
// (same "computed once" posture as Commission).
model SalesRepCommission {
  id         String   @id @default(cuid())
  dealId     String   @unique
  deal       Deal     @relation(fields: [dealId], references: [id])
  salesRepId String
  salesRep   User     @relation(fields: [salesRepId], references: [id])

  rate   Float // % snapshot at time of computation
  amount Float // dealValue * rate/100, computed once

  status String    @default("pending") // pending | paid
  paidAt DateTime?

  createdAt DateTime @default(now())

  @@map("sales_rep_commissions")
}

// Added 2026-08-16 — a deliberate, confirmed extension of the "rejecting is
// only recorded, no in-app dispute process" stance from the Deal.productStatus
// comment above. The human asked for an actual post-rejection workflow, not
// just a recorded flag: the retailer states a reason and picks one of two
// paths — request the product be returned outright, or propose a revised
// price based on the delivered product's condition. The grower then either
// accepts the revised price (closes the deal at the new finalPrice) or
// insists on the return. Still a single round, no back-and-forth counter
// loop — same "deliberately simpler" scope cut as SplitContract. This is
// still NOT a refund/payment/return-shipping engine — the app tracks the
// resolution, it doesn't move money or arrange the physical return; that
// stays real-world/off-platform, same caveat as everywhere else (§2, §8).
// resolutionType: "return" | "counter_offer" (set when the retailer acts)
// status: "pending" | "counter_accepted" | "return_requested" | "return_approved"
model ProductRejection {
  id     String @id @default(cuid())
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id])

  reason String

  resolutionType String?
  counterPrice   Float?
  counterNote    String?

  status String @default("pending")

  // Computed at rejection time from Deal.rejectionFeeRate/rejectionFeePayer
  // — the rate/payer split was locked in during the original negotiation
  // (CLAUDE.md §14), not decided now. feeAmount is null when the deal's
  // rate is 0 (no fee was ever negotiated). Tracked, not processed — same
  // "this app never moves money" posture as Commission (§8/§11).
  feeAmount      Float?
  feeGrowerOwes  Float?
  feeRetailerOwes Float?
  feeStatus      String  @default("pending") // pending | paid | waived
  feePaidAt      DateTime?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@map("product_rejections")
}

// Broker-set commission on a Deal — see CLAUDE.md §10's explicit note that
// this reverses the platform's earlier no-commission stance, confirmed with
// the human on 2026-08-16 despite the still-open MI broker-licensing
// question in §2. Any broker (platform-wide visibility, see decision #2)
// can set or edit these terms on any deal; the dollar amount is computed
// once the retailer accepts the delivered product (Deal.productStatus ->
// "accepted"), then tracked to "paid" — this app never moves money itself,
// same as every other financial figure here (see CLAUDE.md §8).
// payerType: "grower" | "retailer" | "split"
// status: "pending" | "paid"
model Commission {
  id            String @id @default(cuid())
  dealId        String @unique
  deal          Deal   @relation(fields: [dealId], references: [id])
  setByBrokerId String
  setByBroker   User   @relation(fields: [setByBrokerId], references: [id])

  rate           Float // 0-100 (%), fully custom broker discretion
  payerType      String
  splitGrowerPct Float? // only meaningful when payerType == "split"

  amount       Float? // total commission $, computed on product acceptance
  growerOwes   Float?
  retailerOwes Float?

  status String    @default("pending")
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commissions")
}

// One shipment per accepted+invoiced Deal. Created the moment the retailer
// accepts the invoice and picks a transporter (see CLAUDE.md §3 update on
// transporters). status: "assigned" | "picked_up" | "in_transit" | "delivered".
model Shipment {
  id            String @id @default(cuid())
  dealId        String @unique
  deal          Deal   @relation(fields: [dealId], references: [id])
  transporterId String
  transporter   User   @relation("ShipmentTransporter", fields: [transporterId], references: [id])

  status  String  @default("assigned")
  podUrl  String? // proof-of-delivery photo/signature, uploaded by the transporter on delivery

  // Added 2026-08-16 — free-text instructions for the transporter, set by
  // whichever side owns that leg: the Grower/Processor sets pickup
  // instructions (gate codes, dock/entrance to use, hours, who to ask for),
  // the Retailer sets delivery instructions. Deliberately separate from
  // ShipmentEvent notes (which are the transporter's own per-status-update
  // log) and from scheduledPickupAt/scheduledDeliveryAt below (which are
  // times, not directions) — this is the one place either side can leave a
  // standing note the transporter sees before they ever show up.
  pickupInstructions   String?
  deliveryInstructions String?

  // Added 2026-08-16 — the transporter proposes a pickup/delivery window,
  // and both the grower and retailer have to explicitly accept it before the
  // transporter can move the shipment past "assigned" into "picked_up" (see
  // NEXT_SHIPMENT_STATUS in lib/constants.ts / advanceShipmentStatus in
  // lib/shipments.ts). Re-proposing a new time (transporter changes either
  // date) resets both acceptance flags — an old "yes" shouldn't silently
  // apply to a new time nobody actually agreed to.
  scheduledPickupAt        DateTime?
  scheduledDeliveryAt      DateTime?
  growerAcceptedSchedule   Boolean   @default(false)
  retailerAcceptedSchedule Boolean   @default(false)

  // Added 2026-08-16 — the transporter's own fee for hauling this shipment,
  // separate from both the deal's price (grower/retailer) and the broker's
  // commission (§11). The transporter sets the amount and who pays it
  // (grower/retailer/split) once, then uploads or the app generates a
  // simple invoice — tracked, not processed, same "this app never moves
  // money" posture as everything else (§8/§11/§14). See CLAUDE.md §18.
  transportFeeAmount         Float?
  transportFeePayer          String? // "grower" | "retailer" | "split"
  transportFeeSplitGrowerPct Float?
  transportInvoiceUrl        String?
  transportFeeStatus         String  @default("pending") // pending | paid
  transportFeePaidAt         DateTime?

  // Added 2026-08-20 — who's actually driving this load. Previously the
  // app only recorded which Transporter *company* account was assigned,
  // never an individual driver. Free text, set by the transporter at
  // pickup (matches how pickup/delivery instructions are already
  // free-text, transporter-facing fields).
  driverName  String?
  driverPhone String?

  // Added 2026-08-20 — opt-in live location while a shipment is genuinely
  // in transit (lib/geocoding.ts's sibling, lib/tracking.ts). The driver's
  // own device reports its position via the browser Geolocation API, not
  // any third-party tracking service — see CLAUDE.md for why. Off by
  // default; the driver has to explicitly turn it on, and
  // advanceShipmentStatus clears both the flag and the last-known
  // position the moment a shipment reaches "delivered" — this is
  // real-time positioning, not a permanent location history, and there's
  // no reason to keep a stale point after the load is done.
  locationSharingEnabled Boolean   @default(false)
  lastLat                Float?
  lastLng                Float?
  lastLocationAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ShipmentEvent[]

  @@map("shipments")
}

// Status timeline, logged by the transporter as they update the shipment —
// this is the "tracking" the grower/retailer/broker see.
model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status String
  note   String?

  createdAt DateTime @default(now())

  @@map("shipment_events")
}

// ---------- POS integration scaffolding (added 2026-08-16) ----------
// Requested: push accepted deals into a seller's existing POS (Dutchie,
// Treez, Flowhub, or Cova). All four require becoming a certified/approved
// API partner with that vendor — a business relationship, not just an API
// key a user pastes in — which hasn't happened yet, so there is NO live
// vendor API call anywhere in this codebase. What's built is the
// architecture: a connection record, a common adapter interface
// (lib/pos-integration.ts), and a sync log — every "sync" today produces a
// PosSyncLog row honestly marked stubOnly, not a faked success. See
// CLAUDE.md §18 — don't wire a real vendor call in without real, verified
// partner credentials and current API docs for that vendor.
model PosConnection {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])
  vendor  String // "dutchie" | "treez" | "flowhub" | "cova"
  apiKey  String // NOT encrypted at rest yet — see CLAUDE.md §8-style deferred note in §18
  autoSyncEnabled Boolean @default(false)
  connectedAt     DateTime @default(now())

  syncLogs PosSyncLog[]

  @@map("pos_connections")
}

model PosSyncLog {
  id             String        @id @default(cuid())
  connectionId   String
  connection     PosConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  dealId         String?
  vendor         String
  status         String // "stub_only" | "failed" — never "synced" until a real adapter exists
  message        String
  createdAt      DateTime      @default(now())

  @@map("pos_sync_logs")
}

// ---------- METRC connection scaffolding (added 2026-08-16, second ask) ----------
// SCAFFOLDING ONLY — see lib/metrc-integration.ts. No live METRC API call is
// made anywhere in this codebase yet. CLAUDE.md §2 flags that it isn't
// established whether "Broker" (this platform's core role, full visibility
// into every deal) is a recognized MI license category for wholesale
// transfers — connecting real METRC credentials starts operationally
// treating this platform as part of the compliance chain, which is exactly
// that unresolved question. These models exist so the connection UI is
// ready the moment real API access + legal review land, same "recommend,
// don't act autonomously" posture as everywhere else AI/automation touches
// this app. Do not wire live manifest/transfer calls without both.
model MetrcConnection {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber String?
  userApiKey    String // NOT encrypted at rest yet — same deferred-hardening note as PosConnection.apiKey
  connectedAt   DateTime @default(now())

  @@map("metrc_connections")
}

// Singleton — the platform's own METRC "software vendor" API key (issued by
// METRC to a registered software integrator, used alongside each licensee's
// own MetrcConnection.userApiKey). Admin-only.
model MetrcVendorConfig {
  id           String   @id @default("singleton")
  vendorApiKey String?

  // Added for the Retailer POS module (CLAUDE.md §23) — this app's first
  // real METRC API call. Defaults to true so the very first live call any
  // retailer's connection ever makes goes to METRC's sandbox, not
  // production, until Admin has verified it end-to-end.
  useSandbox Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("metrc_vendor_config")
}

// ---------- Retailer Point of Sale (added 2026-08-16, third ask) ----------
// A native retail checkout for the Retailer role — separate from everything
// above, which is all wholesale (Grower/Processor/Broker -> Retailer). Once
// a wholesale Deal is delivered and accepted, nothing in this app previously
// tracked "how much of it is still on the shelf" or let the retailer ring up
// a sale to an actual consumer; these three models are new for that, not a
// variant of Deal/Shipment. See CLAUDE.md §23 for the full picture, in
// particular: this is the first feature where METRC gets a *live* API call
// (submitSaleToMetrc in lib/metrc-integration.ts) rather than pure
// credential scaffolding — a deliberate, confirmed exception to the
// "METRC is scaffolding-only" posture above, made specifically for POS at
// the human's explicit instruction, not a silent reversal of it elsewhere.

// One row per intake batch: a retailer converts an accepted Deal into
// sellable stock here, once, via lib/pos.ts's createInventoryLotFromDeal.
// quantityRemaining is the only thing sales ever decrement — Deal.finalQuantity
// itself is never touched, staying exactly what it always was (a one-time
// negotiated wholesale total).
// status: "active" | "depleted" | "voided"
model InventoryLot {
  id         String  @id @default(cuid())
  retailerId String
  retailer   User    @relation(fields: [retailerId], references: [id])
  dealId     String? @unique
  deal       Deal?   @relation(fields: [dealId], references: [id])

  // Auto-generated, unique, Code128-renderable — this is what a barcode
  // scanner reads at the register (lib/pos.ts's lookupLotBySku). Not a
  // manufacturer UPC — raw/wholesale cannabis product doesn't come with
  // one, so this app mints its own internal label per lot, same as real
  // dispensary POS systems do.
  sku String @unique

  // The real METRC package tag this lot's product is tracked under.
  // Optional because this app has no other way to learn it — Growers/
  // Processors don't record METRC tags anywhere upstream (Listing/Deal).
  // Retailer must key it in by hand for submitSaleToMetrc to actually
  // attempt a live call; left blank, sales against this lot are recorded
  // in-app but explicitly marked "skipped, no tag" rather than faked.
  metrcPackageTag String?

  productName String
  category    String
  thcPercent  Float?
  unit        String

  // Set at intake for unit-counted products (edibles, pre-rolls) whose
  // potency is labeled in mg per piece rather than a % of mass — thcPercent
  // above covers weight-based flower/concentrate, this covers the other
  // case. Both are optional; the register's THC-equivalency calculator
  // (CLAUDE.md §24) uses whichever applies and shows nothing rather than a
  // fabricated number when neither does (e.g. liquid concentrate by volume).
  thcMgPerUnit Float?

  quantityReceived  Float
  quantityRemaining Float

  // unitCost derived once from the accepted Deal (finalPrice / finalQuantity)
  // at intake. markupPercent is the retailer's own call, per lot — the
  // human's own framing was "some 50%, others a different %" — and stays
  // editable after intake (lib/pos.ts's updateLotMarkup). retailPricePerUnit
  // is recomputed from these two any time either changes, never hand-edited
  // directly, so it can never drift from unitCost * (1 + markupPercent/100).
  unitCost           Float
  markupPercent      Float
  retailPricePerUnit Float

  status String @default("active")

  // Set once, the first time this lot's quantityRemaining crosses below the
  // low-stock threshold (lib/pos.ts's checkAndNotifyLowStock) — guards
  // against re-notifying every Account Executive on every subsequent sale
  // of an already-flagged lot. Never reset: a lot only ever decreases in
  // this app (no restock-in-place flow, a fresh intake creates a new lot),
  // so once flagged, staying flagged is correct.
  lowStockNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems      SaleLineItem[]
  orderLineItems OrderLineItem[]

  @@index([retailerId, status])
  @@map("inventory_lots")
}

// One consumer-facing retail sale. saleNumber is a simple per-retailer
// sequence (display/receipt purposes only, not a security boundary).
// taxRatePercent is stamped onto the sale at checkout time rather than
// computed from a live rate lookup — see CLAUDE.md §23's tax caveat, this
// is explicitly not a certified tax engine.
// tenderType: "cash" | "card" | "other"
// status: "completed" | "voided"
// metrcStatus: "not_submitted" | "skipped_no_tag" | "submitted" | "failed"
model Sale {
  id         String @id @default(cuid())
  retailerId String
  retailer   User   @relation(fields: [retailerId], references: [id])
  saleNumber Int

  subtotal       Float
  taxRatePercent Float
  taxAmount      Float
  total          Float
  tenderType     String

  // Added for the checkout-flexibility quick win (CLAUDE.md §24) — not a
  // customer-accounts/loyalty system, just what the register captures at
  // the moment of sale. orderType: "in_store" | "pickup" | "curbside".
  // customerName stays a free-text, receipt-time snapshot — it is never
  // re-derived from Customer.name, so editing a customer's name later never
  // silently rewrites a past receipt. customerId (below) is the newer,
  // separate link that actually enables cross-visit purchase history —
  // optional, since a walk-in with no phone on file has no Customer at all.
  orderType    String  @default("in_store")
  customerName String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  status String @default("completed")

  // See lib/metrc-integration.ts's submitSaleToMetrc — best-effort, never
  // blocks the sale itself (same try/catch-and-log posture as the existing
  // pushDealToPosIfConnected in lib/pos-integration.ts). metrcError only
  // ever holds this app's own record of what METRC said back; it is not
  // itself the compliance record — see CLAUDE.md §2/§23.
  metrcStatus String  @default("not_submitted")
  metrcError  String?

  createdAt DateTime @default(now())

  lineItems SaleLineItem[]
  order     Order?
  loyaltyLedgerEntries LoyaltyLedgerEntry[]

  @@unique([retailerId, saleNumber])
  @@index([retailerId, status])
  @@index([customerId])
  @@map("sales")
}

// One row per retailer, atomically incremented inside createSale's own
// transaction (upsert + increment) to hand out the next saleNumber. Replaces
// a SELECT MAX(saleNumber)+1 pattern that raced under concurrent checkouts
// at the same retailer — Postgres's row-level lock on the UPDATE serializes
// concurrent terminals correctly instead of throwing on the @@unique above.
// Scoped per retailer, so contention never crosses store locations.
model SaleCounter {
  retailerId String @id
  retailer   User   @relation(fields: [retailerId], references: [id])
  value      Int    @default(0)

  @@map("sale_counters")
}

// A retailer's own recognized repeat customer at the register — a deliberate
// reversal of this app's prior "receipt-only, never re-identify" stance for
// Sale.customerName (confirmed with the human before building, since it's a
// real privacy/architecture decision, not a quiet default). No password, no
// login, no online account — phone number is simply the lookup key a
// budtender types in to recognize "this is the same person as last visit".
// Scoped per retailer like every other retailer-owned record in this app —
// a customer at one dispensary is invisible to another, no cross-retailer
// sharing, no platform-wide customer graph.
model Customer {
  id         String @id @default(cuid())
  retailerId String
  retailer   User   @relation(fields: [retailerId], references: [id])

  name  String
  phone String // normalized (digits only) before matching/storing
  notes String? // free text, e.g. "loves flower, allergic to citrus terpenes"

  // Simple running balance, kept correct by createSale's own atomically
  // guarded increment (same discipline as InventoryLot.quantityRemaining's
  // decrement) — never read-then-written outside a transaction. The real
  // history lives in LoyaltyLedgerEntry below; this is a cached total.
  loyaltyPointsBalance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales          Sale[]
  loyaltyEntries LoyaltyLedgerEntry[]

  @@unique([retailerId, phone])
  @@index([retailerId])
  @@map("customers")
}

// Every loyalty accrual (+points, tied to the Sale that earned them) and
// redemption (-points, tied to the discount it funded) is a real logged
// row — same "log every event" convention as SalesRepCommission/
// MarketingMessage/ShipmentEvent elsewhere in this app, rather than just
// mutating Customer.loyaltyPointsBalance with no trail.
model LoyaltyLedgerEntry {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  saleId     String? // set for accrual entries, null for a standalone redemption
  sale       Sale?    @relation(fields: [saleId], references: [id])

  points Int // positive = accrual, negative = redemption
  reason String // e.g. "Earned on sale #42" / "Redeemed for $5.00 off"

  createdAt DateTime @default(now())

  @@index([customerId])
  @@map("loyalty_ledger_entries")
}

// ---------- Customer order-ahead / pickup (added 2026-08-17) ----------
// A customer-placed pre-order — deliberately NOT a Sale. createSale
// decrements real, METRC-tracked inventory the instant it runs; a stranger
// submitting a public web form is not the same event as product actually
// leaving the shelf. This is the "placed but not yet fulfilled" record —
// lib/pos.ts's fulfillOrder converts it into a real Sale (reusing createSale
// itself) only once the retailer hands the product over in person and picks
// a tender type. See CLAUDE.md §25.
//
// Guest-only by design: customerName/customerPhone are free text, same
// "not an account, never used to re-identify a past order" posture as
// Sale.customerName (§24) — there is no Customer/User row backing this.
// ageAttested is a checkbox, not real ID verification — that still happens
// in person at pickup, same as any walk-in purchase.
// status: "placed" | "ready" | "picked_up" | "canceled"
model Order {
  id         String @id @default(cuid())
  retailerId String
  retailer   User   @relation(fields: [retailerId], references: [id])

  customerName  String
  customerPhone String
  ageAttested   Boolean @default(false)

  // Real consent capture for lib/marketing-sms.ts (CLAUDE.md §29) — a
  // separate, optional, unchecked-by-default checkbox at checkout, distinct
  // from ageAttested (which is required and not consent-related at all).
  // This is what actually distinguishes "we have this phone number because
  // you placed a pickup order" from "you agreed to receive marketing texts"
  // — the two were flagged in §28 as conflated; this field is the fix.
  marketingOptIn Boolean @default(false)

  // Free-text pickup preference ("today after 3pm") — not a real scheduling
  // system, same spirit as Shipment's simple date fields elsewhere.
  requestedPickupNote String?

  status String @default("placed")

  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems OrderLineItem[]

  @@index([retailerId, status])
  @@map("orders")
}

model OrderLineItem {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryLotId String
  inventoryLot   InventoryLot @relation(fields: [inventoryLotId], references: [id])

  quantity          Float
  unitPriceSnapshot Float // retailPricePerUnit at the moment the order was placed
  lineTotal         Float

  @@index([orderId])
  @@map("order_line_items")
}

// ---------- Retailer SMS marketing scaffolding (added 2026-08-17) ----------
// SCAFFOLDING ONLY, same posture as PosConnection/MetrcConnection —
// see lib/marketing-sms.ts. Storing a retailer's own Twilio credentials
// does NOT mean live sends happen: sendSpecialsMessage never makes a real
// Twilio API call, regardless of whether credentials are on file, until the
// human explicitly asks for that (same "flag, don't build past it" posture
// as METRC in §2/§19 — this feature is more legally sensitive, not less,
// since unsolicited-adjacent marketing SMS is TCPA-regulated). Retailer-
// owned (not a platform-wide vendor key like MetrcVendorConfig) — each
// dispensary sends its own specials to its own customers. See CLAUDE.md §29.
model SmsConnection {
  id              String   @id @default(cuid())
  retailerId      String   @unique
  retailer        User     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  accountSid      String
  authToken       String // encrypted at rest via lib/crypto.ts, same as MetrcConnection
  fromPhoneNumber String
  connectedAt     DateTime @default(now())

  @@map("sms_connections")
}

// One row per compose-and-send attempt — status is "stub_only" until a real
// Twilio integration exists, matching PosSyncLog's honesty convention: an
// entry here is proof something was *attempted*, never proof a text
// actually reached anyone.
model MarketingMessage {
  id             String   @id @default(cuid())
  retailerId     String
  retailer       User     @relation(fields: [retailerId], references: [id])
  body           String
  recipientCount Int
  status         String // "stub_only" | "failed" — never "sent" until real
  message        String
  createdAt      DateTime @default(now())

  @@map("marketing_messages")
}

model SaleLineItem {
  id             String       @id @default(cuid())
  saleId         String
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryLotId String
  inventoryLot   InventoryLot @relation(fields: [inventoryLotId], references: [id])

  quantity  Float
  unitPrice Float // snapshot of retailPricePerUnit at time of sale
  lineTotal Float

  // Manual, register-entered discount (flat $, not a %) — lineTotal is
  // already the net amount actually charged (quantity*unitPrice minus this),
  // so discountAmount only exists to let the receipt/register show the
  // struck-through original price. Not an auto-apply/stacking rules engine —
  // deliberately simpler, same scope-cut posture as SplitContract/
  // ProductRejection elsewhere in this app.
  discountAmount Float @default(0)

  @@index([saleId])
  @@map("sale_line_items")
}

// ---------- Statewide monthly market report (added 2026-08-16) ----------
// Michigan's Cannabis Regulation Agency (CRA) publishes an official monthly
// report (Medical + Adult-Use programs) with statewide sales-by-category,
// sales-by-region, active license counts, and average retail flower price.
// The human uploads that .docx every month (Admin-only, see
// lib/monthly-report.ts) and it's parsed into this table so every portal
// can show real statewide market context alongside this platform's own
// internal Market Pulse (lib/market.ts, which only reflects this
// platform's own listings/deals — a much smaller sample). This is public
// state regulatory data, not anything about this platform's own users.
model MonthlyMarketReport {
  id             String   @id @default(cuid())
  reportMonth    DateTime @unique // normalized to the 1st of the month
  reportLabel    String // "July 2026"
  sourceFileName String?
  uploadedById   String
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  uploadedAt     DateTime @default(now())

  // Headline Adult-Use (recreational) figures — the program this platform's
  // wholesale market actually operates under. Denormalized onto the row for
  // fast trend queries without unpacking the JSON blobs below every time.
  auTotalSales                Float?
  auTotalPoundsSold            Float?
  auAvgRetailFlowerPricePerOz Float?
  auSalesToDate                Float?
  auActiveLicensesTotal        Int?

  // Same headline figures for the Medical program, for context.
  medTotalSales                Float?
  medTotalPoundsSold           Float?
  medAvgRetailFlowerPricePerOz Float?

  // Full structured breakdown — category × {poundsSold, flOzSold,
  // totalSales} for both programs, plus the 5-region breakdown and active
  // license counts by license type. Kept as JSON rather than one column per
  // cell: the report has ~10 product categories × 5 regions × 2 programs,
  // and Claude doesn't control this document's shape — modeling every cell
  // as a dedicated migration would be unmaintainable churn.
  auCategoryBreakdown   Json?
  medCategoryBreakdown  Json?
  auRegionalBreakdown   Json?
  medRegionalBreakdown  Json?
  activeLicensesByType  Json?

  // Fallback dump of whatever text the parser pulled from the .docx, so a
  // human can eyeball what didn't map cleanly to a field above.
  rawExtractedText String?

  @@map("monthly_market_reports")
}

// ---------- License registry (added 2026-08-16) ----------
// Imported from the state of Michigan's CRA licensee exports (5 category
// files: Class B/C Grower, Processor, Retailer, Secure Transporter — no
// "Broker" category exists in the state data, consistent with CLAUDE.md §2's
// still-open question). Looked up by license number at signup to
// auto-populate business name/address and, on an "active" match, skip the
// manual Admin queue — see lib/license-registry.ts for the matching and
// auto-approval logic, and CLAUDE.md §12 for the honesty tradeoff this
// implies (a license *number* match isn't proof of who's typing it in).
model LicenseRegistry {
  id             String    @id @default(cuid())
  licenseNumber  String    @unique
  category       String // grower_b | grower_c | processor | retailer | transporter
  recordType     String? // state's own label, e.g. "Class C Marihuana Grower - License"
  businessName   String
  street         String?
  city           String?
  state          String?
  zip            String?
  status         String // state's raw status string, e.g. "Active", "License Void"
  expirationDate DateTime?
  hasDisciplinaryAction Boolean @default(false)

  // Phone/contact enrichment merged in from the platform owner's own lead
  // list, matched by normalized business name (the two datasets use
  // different license-number schemes, so name is the only reliable join key
  // — see the merge note in scripts/import-license-registry.mjs). Null when
  // no match was found; state data alone still covers name/address/status.
  phone String?

  importedAt DateTime @default(now())

  @@index([businessName])
  @@map("license_registry")
}

// ---------- Sales lead CRM (added 2026-08-16) ----------
// Real backing store for the sales team's cold-calling tool (previously a
// standalone HTML artifact using an ephemeral, artifact-scoped
// window.storage key-value API — not a durable multi-user database, and
// not reachable from this app). This is Phase 1 (core CRM: list, search,
// filter, disposition tracking, call logging, notes, CSV export) — the
// Power Dialer / callback calendar / dashboard UI from the source artifact
// are deliberately not ported yet, per the human's explicit phasing choice.
//
// Visibility: every sales_rep and admin sees every lead across every list
// — the human explicitly chose this over per-rep visibility silos (the
// source artifact's SHARED flag varied by list; this app doesn't replicate
// that split). assignedRepName is preserved as free text from the
// imported data (the original tool had no real user accounts backing rep
// names) rather than forced into a User foreign key.
model Lead {
  id String @id @default(cuid())

  // Which of the 3 imported lists this record came from — mirrors the
  // source artifact's workspace tabs, minus "taino" (the source tool had a
  // 4th "Taino List" tab; the human confirmed it isn't used on this platform).
  // "leads" | "mi_processors" | "mi_dispensaries"
  listKey String

  // The source artifact's per-list primary dimension — a call-status tag
  // (NA/DC/AB/SALE/etc.), kept as free text since its meaning and allowed
  // values differ per list and this app doesn't enforce a fixed set.
  primaryStatus String @default("")

  company    String
  contact    String?
  phone      String?
  altPhone   String?
  email      String?
  website    String?

  address String?
  city    String?
  state   String?
  zip     String?

  license       String?
  licenseType   String?
  licenseStatus String?
  serviceZone   String?

  notes String?

  assignedRepName String? // free text, preserved from imported data — see model comment

  // Added 2026-08-21 — the REAL ownership link, distinct from the free-text
  // assignedRepName above (which never reliably matched a logged-in AE's
  // actual account). Claimed automatically the first time any AE makes
  // real contact with this lead (a call, a text, a disposition change) —
  // same "claim on first contact" mechanism already used for grower/
  // processor accounts (User.assignedSalesRepId, CLAUDE.md §38), not a
  // new pattern invented for this. Null = unclaimed, visible to every AE;
  // once claimed, only that AE (and Admin, always unrestricted) sees it in
  // their own Marketing Suite / Power Dialer.
  assignedSalesRepId String?
  assignedSalesRep   User?   @relation(fields: [assignedSalesRepId], references: [id])

  // disposition: NEW | NO_PHONE | NO_ANSWER | BUSY | CALLBACK | EMAIL_SENT | SALE | DISCONNECTED | DECLINED | DNC
  disposition  String    @default("NEW")
  saleAmount   Float?
  callbackDate DateTime?

  calledCount Int       @default(0)
  lastCallAt  DateTime?

  // Set only via a real click on the unsubscribe link every marketing
  // email carries (lib/lead-email.ts's sendEmailToLead appends it
  // automatically to every send) — CAN-SPAM requires honoring this
  // specific opt-out, distinct from the DNC disposition (which is a
  // phone/SMS-origin signal and is ALSO checked before sending email, as
  // a courtesy, but isn't itself a CAN-SPAM unsubscribe).
  emailUnsubscribedAt DateTime?

  deleted Boolean @default(false) // soft-delete, matches the source tool's "remove/restore" pattern

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity        LeadActivityLog[]
  phoneNumbers    LeadPhoneNumber[]
  campaignItems   LeadMessageCampaignItem[]

  @@index([listKey])
  @@index([disposition])
  @@index([assignedSalesRepId])
  @@map("leads")
}

// Added 2026-08-21 — a business often has several real contacts (the
// original grower, a sales rep, a second location's manager), and the
// single `phone`/`altPhone` fields above only ever fit two, with no name
// attached to either. Up to 5 named numbers per lead, ordered by
// `sortOrder` (0 = main/primary, 1 = second choice, etc.) — "set as main"
// / "set as 2nd" in the UI just reorders this list rather than being a
// separate boolean per slot. `Lead.phone` stays in sync with whichever
// number is at sortOrder 0 (see lib/leads.ts's setLeadPhoneNumbers) so
// every existing phone-dependent path (search, the tel: click-to-call
// link, Vonage texting) keeps working unchanged — they were never
// rewritten to look here, they just keep reading the one field that's now
// kept current.
model LeadPhoneNumber {
  id       String @id @default(cuid())
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  phone    String
  name     String? // e.g. "Dana — sales rep", free text
  sortOrder Int    @default(0)

  // Set automatically when an inbound reply to this number says "wrong
  // number" (this specific number is bad — the business itself may still
  // be reachable via another one) or "stop"/"do not call" (blocks this
  // number specifically; a STOP reply also flips the whole Lead to the
  // DNC disposition, which is the actual platform-wide suppression — see
  // lib/vonage-inbound.ts). sendSmsToLead refuses to text a blocked
  // number even if a caller somehow still has it on hand.
  blocked       Boolean @default(false)
  blockedReason String?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_phone_numbers")
}

model LeadActivityLog {
  id       String @id @default(cuid())
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId String? // sales_rep or admin User who logged this — nullable since imported history has no real author

  text      String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_activity_logs")
}

// Added 2026-08-21 — "AI text message creator": an AE/Admin writes one
// generic template, optionally has Claude draft a personalized version per
// selected lead (lib/lead-messaging.ts's personalizeMessagesForLeads), then
// reviews/edits every line before anything is created here — same "drafts,
// never auto-sends" posture as structureListingDraftsBulk. A campaign can
// send as soon as possible (scheduledFor null) or at a specific future
// time ("a week from now"), since this app has no background-job
// infrastructure anywhere else — see the cron route at
// /api/cron/send-scheduled-messages, the actual mechanism that makes a
// future scheduledFor eventually fire.
model LeadMessageCampaign {
  id            String  @id @default(cuid())
  createdByRole String // "sales_rep" | "admin"
  createdById   String
  createdBy     User    @relation("LeadCampaignCreatedBy", fields: [createdById], references: [id])

  // "sms" | "email" — added when email outreach shipped alongside SMS.
  // Determines which send path processDueCampaigns takes (sendSmsToLead
  // vs. lib/lead-email.ts's sendEmailToLead) and whether `subject` below
  // is used. Every pre-existing campaign is implicitly "sms" via the
  // default, so this is additive — nothing about the SMS path changed.
  channel String @default("sms")
  // Only used when channel = "email" — a single subject line for the
  // whole campaign (not AI-personalized per lead, unlike the body text;
  // real email campaign tools generally use one subject across a send).
  subject String?

  templateText String
  // False when the "not configured"/error fallback sent the same literal
  // template to everyone instead of a real per-lead personalization —
  // surfaced in the UI so nobody mistakes an unpersonalized blast for one
  // that actually was.
  personalized Boolean @default(false)

  // Null = send as soon as the next processing pass picks it up (still
  // routed through the same due-campaign path as a scheduled one, not sent
  // synchronously inline — see processDueCampaigns for why: a large
  // campaign sending "at once" needs the same bounded-batch handling a
  // scheduled one does, to avoid a single request timing out or hammering
  // Vonage's own rate limits).
  scheduledFor DateTime?
  // scheduled | sending | sent | canceled
  status String @default("scheduled")

  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  canceledAt DateTime?

  items LeadMessageCampaignItem[]

  @@index([status, scheduledFor])
  @@map("lead_message_campaigns")
}

model LeadMessageCampaignItem {
  id         String              @id @default(cuid())
  campaignId String
  campaign   LeadMessageCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead                @relation(fields: [leadId], references: [id])

  text String // the exact, human-reviewed text for this one lead

  // pending | sent | failed | skipped_blocked | skipped_dnc |
  // skipped_claimed (another AE claimed this lead between scheduling and
  // send time) | canceled
  status       String  @default("pending")
  errorMessage String?
  sentAt       DateTime?

  @@index([campaignId])
  @@index([leadId])
  @@map("lead_message_campaign_items")
}

// Postgres-backed replacement for the in-memory per-IP sliding-window
// limiters that used to live directly in /api/license-lookup and the
// storefront order action (both flagged in CLAUDE.md §21 as not holding
// across more than one serverless instance). Not tied to a User — this
// exists specifically for the app's genuinely unauthenticated write
// surfaces, keyed by an arbitrary "scope:identifier" string (e.g.
// "license-lookup:203.0.113.5"). See lib/rate-limit.ts for the atomic
// fixed-window upsert that reads/writes this table in one statement.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@map("rate_limit_buckets")
}
