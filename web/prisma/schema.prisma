// MI Cannabis Exchange — Prisma schema
// Postgres (Supabase) — see CLAUDE.md §7. Started on SQLite for zero-setup
// local dev; moved to hosted Postgres once a project was provisioned.
// role/category/status fields stayed plain Strings (not native Postgres
// enums) rather than churn every model now that a real enum type is
// available — valid values are enforced in application code, see
// src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Core identity ----------
// role: "grower" | "processor" | "retailer" | "broker" | "transporter" | "admin"
model User {
  id           String   @id @default(cuid())
  role         String
  email        String   @unique
  passwordHash String
  fullName     String
  businessName String?

  // Pickup/delivery address — grower/processor/retailer fill this in at
  // signup so a Shipment has somewhere to route to. Not collected for
  // broker/transporter/admin.
  address String?
  city    String?
  state   String?
  zip     String?

  // License fields — grower/processor/retailer/transporter only (MI's Secure
  // Transporter license, same licensing tier as the others). Verified by
  // Admin, never auto-verified (no MI equivalent of FMCSA SAFER exists yet,
  // see CLAUDE.md §8).
  licenseNumber       String?
  licenseType         String?
  licenseVerification String  @default("unverified") // unverified | approved | rejected
  licenseExpiry       DateTime? // shown in Admin's license expiration alerts

  // Platform owner's default transporter, pre-selected (but overridable) when
  // a retailer picks who ships their deal. Admin-only toggle. Only meaningful
  // for role = transporter.
  preferredTransporter Boolean @default(false)

  // Stable anonymous handle shown to the counterparty across the blind
  // marketplace boundary, e.g. "Grower #A17". Generated once at signup,
  // never derived from the real name so it can't leak identity. Transporters
  // get one too for consistency, but their real business name is always
  // shown — transport identity isn't part of the grower/retailer blind
  // boundary, see CLAUDE.md §3/§10.
  anonHandle String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings           Listing[]       @relation("ListingPostedBy")
  offerRoundsMade    OfferRound[]    @relation("OfferRoundActor")
  retailerThreads    OfferThread[]   @relation("ThreadRetailer")
  dealsAsSeller      Deal[]          @relation("DealSeller")
  dealsAsRetailer    Deal[]          @relation("DealRetailer")
  shipmentsHauled    Shipment[]      @relation("ShipmentTransporter")
  watchlistEntries   Watchlist[]
  splitContractsAsGrower    SplitContract[] @relation("SplitContractGrower")
  splitContractsAsProcessor SplitContract[] @relation("SplitContractProcessor")
  notifications      Notification[]
  commissionsSet      Commission[]

  @@map("users")
}

// In-app only — no SMS/push, see CLAUDE.md §8. type is a free-form tag
// ("offer_viewed", "offer_countered", ...) used for icon/routing choices in
// the UI, not enforced at the DB layer.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  threadId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ---------- Listings ----------
// category: "flower" | "concentrate" | "vape" | "edible" | "pre_roll" | "other"
// unit: "lb" | "liter" | "unit"
// terms: "cash" | "net_30" | "negotiable"
// status: "active" | "expired" | "closed" (closed = a Deal was made)
model Listing {
  id          String   @id @default(cuid())
  postedById  String
  postedBy    User     @relation("ListingPostedBy", fields: [postedById], references: [id])

  strainName  String
  category    String
  thcPercent  Float?
  quantity    Float
  unit        String
  pricePerUnit Float
  terms       String
  notes       String?

  status    String   @default("active")
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media   ListingMedia[]
  threads OfferThread[]
  watchlistedBy  Watchlist[]
  splitContracts SplitContract[]

  @@index([status])
  @@map("listings")
}

// A retailer tracking a listing they haven't (yet) made an offer on.
model Watchlist {
  id         String   @id @default(cuid())
  retailerId String
  retailer   User     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([retailerId, listingId])
  @@map("watchlist_entries")
}

// Toll-processing agreement: a Processor sources raw material from a
// Grower's listing not for a flat price, but for a % share of the finished
// product's eventual value. One proposal per (listing, processor) pair — a
// grower listing can receive proposals from multiple processors, same
// pattern as OfferThread. Deliberately simpler than the price/terms
// negotiation state machine (single propose -> accept/reject, no counter
// loop) — a v1 scope cut, not an oversight.
//
// The platform never sets or takes a cut of the split — see CLAUDE.md's
// no-commission design. Physical pickup/transport for a settled contract is
// coordinated directly between grower and processor for now; wiring this
// into the existing Shipment/transporter flow is a deferred follow-up
// (same spirit as CLAUDE.md §8's other deferred items), not silently
// treated as solved.
//
// status: "proposed" | "accepted" | "rejected" | "processing" | "finished" | "settled"
model SplitContract {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  growerId    String
  grower      User @relation("SplitContractGrower", fields: [growerId], references: [id])
  processorId String
  processor   User @relation("SplitContractProcessor", fields: [processorId], references: [id])

  outputProduct  String
  splitGrowerPct Float
  note           String?

  status String @default("proposed")

  yieldQty  Float?
  yieldUnit String?

  settlementValue           Float?
  settlementGrowerAmount    Float?
  settlementProcessorAmount Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, processorId])
  @@index([status])
  @@map("split_contracts")
}

// type: "image" | "video"
model ListingMedia {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("listing_media")
}

// ---------- Negotiation ----------
// One thread per (listing, retailer) pair. status: "open" | "accepted" | "rejected" | "expired"
model OfferThread {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  retailerId  String
  retailer    User     @relation("ThreadRetailer", fields: [retailerId], references: [id])

  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // View tracking, per side — powers the "X viewed your offer N times"
  // alert. Counts increment on every view (a reload counts as a view, same
  // as most view-counters); notifications for it are throttled separately
  // in lib/offers.ts so a reloading tab doesn't spam the other party.
  sellerViewCount      Int       @default(0)
  sellerLastViewedAt   DateTime?
  retailerViewCount    Int       @default(0)
  retailerLastViewedAt DateTime?

  rounds OfferRound[]
  deal   Deal?

  @@unique([listingId, retailerId])
  @@index([status])
  @@map("offer_threads")
}

// action: "counter" | "accept" | "reject"
// actorRole is denormalized ("retailer" | "seller") so anonymization logic
// never has to resolve actorId's real role for display to the other party.
model OfferRound {
  id        String   @id @default(cuid())
  threadId  String
  thread    OfferThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation("OfferRoundActor", fields: [actorId], references: [id])
  actorRole String

  action    String
  price     Float?
  quantity  Float?
  terms     String?
  message   String?

  createdAt DateTime @default(now())

  @@map("offer_rounds")
}

// Created when a thread's status becomes "accepted". Holds both real
// identities — but per CLAUDE.md §3/§6, only broker-, admin-, and (once a
// Shipment exists) assigned-transporter-scoped queries are allowed to
// resolve sellerId/retailerId through to their real User records. The
// seller's and retailer's own deal views (src/lib/shipments.ts) query this
// same table but only ever render the *other* party through their
// anonHandle, never these relations directly.
model Deal {
  id         String   @id @default(cuid())
  threadId   String   @unique
  thread     OfferThread @relation(fields: [threadId], references: [id])
  listingId  String

  sellerId    String
  seller      User   @relation("DealSeller", fields: [sellerId], references: [id])
  retailerId  String
  retailer    User   @relation("DealRetailer", fields: [retailerId], references: [id])

  finalPrice    Float
  finalQuantity Float
  finalTerms    String

  // Fulfillment: an invoice is auto-generated the moment the deal is
  // created (see lib/invoice.ts) so the retailer is never blocked waiting
  // on the grower; the grower can still upload their own file to override
  // it (invoiceAutoGenerated flips to false). Retailer reviews and accepts
  // it, which is what triggers transporter selection (see Shipment below).
  // Nothing here is legally a completed transfer — see CLAUDE.md §2.
  invoiceUrl           String?
  invoiceUploadedAt    DateTime?
  invoiceAcceptedAt    DateTime?
  invoiceAutoGenerated Boolean   @default(false)

  // Retailer's explicit accept/reject of the physically delivered product —
  // only actionable once the Shipment reaches "delivered". Accepting shows
  // a final-sale notice and is what triggers the commission amount to be
  // computed (see Commission below). Rejecting is recorded but this app
  // does NOT run a refund/return/dispute-resolution process — that's real-
  // world, Broker-mediated, same caveat as CLAUDE.md §2's transfer language.
  // status: "pending" | "accepted" | "rejected"
  productStatus     String    @default("pending")
  productDecisionAt DateTime?

  createdAt DateTime @default(now())

  shipment   Shipment?
  commission Commission?

  @@map("deals")
}

// Broker-set commission on a Deal — see CLAUDE.md §10's explicit note that
// this reverses the platform's earlier no-commission stance, confirmed with
// the human on 2026-08-16 despite the still-open MI broker-licensing
// question in §2. Any broker (platform-wide visibility, see decision #2)
// can set or edit these terms on any deal; the dollar amount is computed
// once the retailer accepts the delivered product (Deal.productStatus ->
// "accepted"), then tracked to "paid" — this app never moves money itself,
// same as every other financial figure here (see CLAUDE.md §8).
// payerType: "grower" | "retailer" | "split"
// status: "pending" | "paid"
model Commission {
  id            String @id @default(cuid())
  dealId        String @unique
  deal          Deal   @relation(fields: [dealId], references: [id])
  setByBrokerId String
  setByBroker   User   @relation(fields: [setByBrokerId], references: [id])

  rate           Float // 0-100 (%), fully custom broker discretion
  payerType      String
  splitGrowerPct Float? // only meaningful when payerType == "split"

  amount       Float? // total commission $, computed on product acceptance
  growerOwes   Float?
  retailerOwes Float?

  status String    @default("pending")
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commissions")
}

// One shipment per accepted+invoiced Deal. Created the moment the retailer
// accepts the invoice and picks a transporter (see CLAUDE.md §3 update on
// transporters). status: "assigned" | "picked_up" | "in_transit" | "delivered".
model Shipment {
  id            String @id @default(cuid())
  dealId        String @unique
  deal          Deal   @relation(fields: [dealId], references: [id])
  transporterId String
  transporter   User   @relation("ShipmentTransporter", fields: [transporterId], references: [id])

  status  String  @default("assigned")
  podUrl  String? // proof-of-delivery photo/signature, uploaded by the transporter on delivery

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ShipmentEvent[]

  @@map("shipments")
}

// Status timeline, logged by the transporter as they update the shipment —
// this is the "tracking" the grower/retailer/broker see.
model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  status String
  note   String?

  createdAt DateTime @default(now())

  @@map("shipment_events")
}
